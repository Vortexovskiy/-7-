-- Anti Kick (Pencil Sticky) — предмет клеится на спину, авто-респавн при сбросе
do
    local plr = Player
    local X, Y, Z = -1, 2, 0.5
    local RX, RY, RZ = 90, 33, 0
    local TOY_NAME = "ToolPencil"
    local pencilOn = false
    local pencilRespawnReady = true
    local pencilRespawnId = 0

    local function isAttachedToBack(toy)
        if toy and toy:FindFirstChild("StickyPart") then
            local weld = toy.StickyPart:FindFirstChild("StickyWeld")
            if weld and weld.Part1 then
                local part = weld.Part1
                if part.Name == "Head" then return false, true end
                if plr.Character and part == plr.Character:FindFirstChild("HumanoidRootPart") then return true, false end
                return false, false
            end
        end
        return false, false
    end

    local function ClearNinjaKunai()
        local inv = Workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
        local destroyrem = ReplicatedStorage:FindFirstChild("MenuToys") and ReplicatedStorage.MenuToys:FindFirstChild("DestroyToy")
        if inv and destroyrem then
            for _, v in pairs(inv:GetChildren()) do
                if v.Name == "AntiKick" or v.Name == TOY_NAME then
                    local onBack, _ = isAttachedToBack(v)
                    if onBack then continue end
                    pcall(function() destroyrem:FireServer(v) end)
                end
            end
        end
    end

    local function DisableToyCollision(Toy)
        if not Toy then return end
        for _, obj in pairs(Toy:GetChildren()) do
            if obj.Name == "Pyramid" or obj.Name == "Main" or obj:IsA("BasePart") then
                obj.CanTouch = false
                obj.CanCollide = false
                obj.CanQuery = false
            end
        end
    end

    local function setPencilAntiKick(Value)
            pencilOn = Value
            pencilRespawnReady = Value
            if not Value then
                pencilRespawnId = pencilRespawnId + 1
                ClearNinjaKunai()
                return
            end

            task.spawn(function()
                local setOwner = ReplicatedStorage:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
                local stickyEvent = ReplicatedStorage:WaitForChild("PlayerEvents"):WaitForChild("StickyPartEvent")
                local spawnRemote = ReplicatedStorage.MenuToys.SpawnToyRemoteFunction
                local canSpawn = plr:WaitForChild("CanSpawnToy")

                local function getHRP()
                    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                        return plr.Character.HumanoidRootPart
                    else
                        local character = plr.CharacterAdded:Wait()
                        return character:WaitForChild("HumanoidRootPart")
                    end
                end

                local function CheckForHome()
                    if not Workspace.PlotItems.PlayersInPlots:FindFirstChild(plr.Name) then return false end
                    for _, v in pairs(Workspace.Plots:GetChildren()) do
                        local sign = v:FindFirstChild("PlotSign")
                        local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
                        if owners then
                            for _, b in pairs(owners:GetChildren()) do
                                if b.Value == plr.Name then
                                    local folder = Workspace.PlotItems:FindFirstChild(v.Name)
                                    if folder then return true, folder end
                                end
                            end
                        end
                    end
                    return false
                end

                local function StickNinjaKunai(NinjaKunai)
                    if not NinjaKunai or not NinjaKunai:FindFirstChild("StickyPart") then return end
                    local currentHRP = getHRP()
                    if not currentHRP then return end
                    DisableToyCollision(NinjaKunai)
                    if NinjaKunai:FindFirstChild("SoundPart") then
                        if not NinjaKunai.SoundPart:FindFirstChild("PartOwner") or NinjaKunai.SoundPart.PartOwner.Value ~= plr.Name then
                            setOwner:FireServer(NinjaKunai.SoundPart, NinjaKunai.SoundPart.CFrame)
                        end
                    end
                    local firePart = currentHRP:FindFirstChild("FirePlayerPart") or currentHRP:WaitForChild("FirePlayerPart", 5)
                    if firePart then
                        stickyEvent:FireServer(
                            NinjaKunai.StickyPart,
                            firePart,
                            CFrame.new(X, Y, Z) * CFrame.Angles(math.rad(RX), math.rad(RY), math.rad(RZ))
                        )
                    end
                end

                local function SpawnToy(name)
                    local t = tick()
                    while not canSpawn.Value do
                        if not pencilOn or tick() - t > 5 then return nil end
                        task.wait(0.05)
                    end
                    local currentHRP = getHRP()
                    if currentHRP then
                        task.spawn(function()
                            pcall(function()
                                spawnRemote:InvokeServer(name, currentHRP.CFrame * CFrame.new(0, 12, 20), Vector3.new(0, 0, 0))
                            end)
                        end)
                    end
                    local boolik, house = CheckForHome()
                    local inv = Workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
                    if boolik and house then
                        return house:WaitForChild(name, 1)
                    elseif not Workspace.PlotItems.PlayersInPlots:FindFirstChild(plr.Name) and inv then
                        return inv:WaitForChild(name, 1)
                    end
                    return nil
                end

                while pencilOn do
                    task.wait(0.005)
                    -- После респавна не создаём защитный предмет раньше заданных 0.5 сек.
                    if not pencilRespawnReady then
                        continue
                    end
                    if not plr.Character or not plr.Character:FindFirstChild("Humanoid") or plr.Character.Humanoid.Health <= 0 then
                        continue
                    end

                    local inv = Workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
                    local NinjaKunai = inv and (inv:FindFirstChild("AntiKick") or inv:FindFirstChild(TOY_NAME))

                    if not NinjaKunai then
                        if Workspace.PlotItems.PlayersInPlots:FindFirstChild(plr.Name) then
                            local boolik, house = CheckForHome()
                            if boolik and house and Workspace.Plots:FindFirstChild(house.Name) then
                                local sign = Workspace.Plots[house.Name]:FindFirstChild("PlotSign")
                                if sign and sign.ThisPlotsOwners.Value.TimeRemainingNum.Value > 89 then
                                    NinjaKunai = SpawnToy(TOY_NAME)
                                    if NinjaKunai then
                                        NinjaKunai.Name = "AntiKick"
                                        StickNinjaKunai(NinjaKunai)
                                    end
                                end
                            end
                        end
                        if not NinjaKunai and not Workspace.PlotItems.PlayersInPlots:FindFirstChild(plr.Name) then
                            NinjaKunai = SpawnToy(TOY_NAME)
                            if NinjaKunai then
                                NinjaKunai.Name = "AntiKick"
                                StickNinjaKunai(NinjaKunai)
                            end
                        end
                    else
                        local onBack, onHead = isAttachedToBack(NinjaKunai)
                        if onHead then
                            ClearNinjaKunai()
                            task.wait(0.005)
                            if Workspace.PlotItems.PlayersInPlots:FindFirstChild(plr.Name) then
                                local boolik, house = CheckForHome()
                                if boolik and house and Workspace.Plots:FindFirstChild(house.Name) then
                                    local sign = Workspace.Plots[house.Name]:FindFirstChild("PlotSign")
                                    if sign and sign.ThisPlotsOwners.Value.TimeRemainingNum.Value > 89 then
                                        local newToy = SpawnToy(TOY_NAME)
                                        if newToy then
                                            newToy.Name = "AntiKick"
                                            StickNinjaKunai(newToy)
                                        end
                                    end
                                end
                            else
                                local newToy = SpawnToy(TOY_NAME)
                                if newToy then
                                    newToy.Name = "AntiKick"
                                    StickNinjaKunai(newToy)
                                end
                            end
                        elseif not onBack then
                            StickNinjaKunai(NinjaKunai)
                        end
                    end
                end

                ClearNinjaKunai()
            end)
    end

    Elm.Sect.DefenseExtra:AddToggle({
        Name = "Anti Kick (Pencil Sticky)",
        Default = false,
        Flag = "PencilAntiKick",
        Callback = setPencilAntiKick
    })

    _G.MellstroyTogglePencilAntiKick = function()
        setPencilAntiKick(not pencilOn)
        notify("Pencil Anti Kick", (pencilOn and "Enabled" or "Disabled"), 2)
    end

    -- CharacterAdded наступает после смерти при создании нового персонажа.
    -- Сначала убираем остатки старого AntiKick, через 0.5 сек основной цикл спавнит новый.
    plr.CharacterAdded:Connect(function(char)
        if not pencilOn then return end
        pencilRespawnId = pencilRespawnId + 1
        local thisRespawn = pencilRespawnId
        pencilRespawnReady = false
        ClearNinjaKunai()

        task.spawn(function()
            local hrp = char:WaitForChild("HumanoidRootPart", 5)
            if not hrp then return end
            task.wait(0.5)
            if pencilOn and thisRespawn == pencilRespawnId and char == plr.Character then
                pencilRespawnReady = true
            end
        end)
    end)
end

