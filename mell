-- =========================================================================
-- УНИВЕРСАЛЬНЫЙ МЕНЕДЖЕР ХОТКЕЕВ — любую функцию можно биндить на любую клавишу.
-- кнопка открытия/закрытия чита тоже перебиндена (через текстбокс).
-- =========================================================================
local BindRegistry = {
    -- ключ (имя бинда) -> { key=Enum, action=fn, label="человеческое имя" }
}

local function registerBind(name, keyEnum, action, label)
    if type(name) ~= "string" or not keyEnum then return end
    BindRegistry[name] = BindRegistry[name] or {}
    BindRegistry[name].key = keyEnum
    BindRegistry[name].action = action or BindRegistry[name].action
    BindRegistry[name].label = label or name
end

local function getBindKey(name)
    local b = BindRegistry[name]
    return b and b.key or Enum.KeyCode.Unknown
end

local function setBindKey(name, newKeyEnum)
    local b = BindRegistry[name]
    if not b then registerBind(name, newKeyEnum, nil, name); return end
    b.key = newKeyEnum
end

local function bindLabel(name)
    local b = BindRegistry[name]
    return b and b.key and b.key.Name or "None"
end

local function parseKeyCode(text)
    local wanted = tostring(text or ""):gsub("%s+", ""):lower()
    if wanted == "" then return nil end
    for _, keyCode in ipairs(Enum.KeyCode:GetEnumItems()) do
        if keyCode.Name:lower() == wanted then return keyCode end
    end
    return nil
end

