    Highlight.OutlineColor = Color3.new(1, 1, 1)
    Highlight.Enabled = false
    Highlight.Parent = FakePart

    -- offset: кастом из боксов, либо авто по пингу
    local function getOffsetCFrame()
        if customDesyncEnabled then
            return CFrame.new(customX, customY, customZ)
        else
            local ping = LocalPlayer:GetNetworkPing() * 1000
            if ping < 100 then return CFrame.new(0, 0, -2)
            elseif ping <= 170 then return CFrame.new(0, 0, -2.7)
            else return CFrame.new(0, 0, -3.7) end
        end
    end

    R.Heartbeat:Connect(function()
        if not desyncT.enabled or not LocalPlayer.Character then
            Highlight.Enabled = false
            return
        end
        local character = LocalPlayer.Character
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        -- детект вращения: при быстром развороте десинк выключаем, чтобы не палиться
        local currentLook = root.CFrame.LookVector
        if prevLookVector then
            local dot = math.clamp(prevLookVector:Dot(currentLook), -1, 1)
            local angleDiff = math.deg(math.acos(dot))
            isSpinning = angleDiff > spinThreshold
        end
        prevLookVector = currentLook
        if isSpinning then return end

        desyncT.loc = root.CFrame
        local newCFrame = desyncT.loc * getOffsetCFrame()
        desyncT.fakeLoc = newCFrame
        FakePart.CFrame = newCFrame
        Highlight.Enabled = true
        root.CFrame = newCFrame

        R.RenderStepped:Wait()
        root.CFrame = desyncT.loc
    end)

    -- хук: возвращаем настоящую позицию при чтении CFrame HumanoidRootPart сервером/скриптами
    if hookmetamethod and newcclosure and checkcaller then
        local desynchook
        desynchook = hookmetamethod(game, "__index", newcclosure(function(self, key)
            if desyncT.enabled and not checkcaller()
                and key == "CFrame"
                and LocalPlayer.Character
                and self == LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                and not isSpinning then
                return desyncT.loc
            end
            return desynchook(self, key)
        end))
    else
        notify("Desync", "Executor lacks hookmetamethod — visual only", 4)
    end

    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        prevLookVector = nil
        isSpinning = false
    end)

    -- UI
    Elm.Sect.PlayerDesync:AddToggle({
        Name = "Desync (key: C)",
        Default = false,
        Flag = "DesyncToggle",
        Callback = function(v)
            desyncT.enabled = v
            if not v then Highlight.Enabled = false end
        end
    })

    Elm.Sect.PlayerDesync:AddToggle({
        Name = "Custom Offset",
        Default = false,
        Flag = "DesyncCustom",
        Callback = function(v) customDesyncEnabled = v end
    })

    Elm.Sect.PlayerDesync:AddTextbox({
        Name = "Offset X",
        Default = "0",
        TextDisappear = false,
        Callback = function(t) customX = tonumber(t) or 0 end
    })
    Elm.Sect.PlayerDesync:AddTextbox({
        Name = "Offset Y",
        Default = "0",
        TextDisappear = false,
        Callback = function(t) customY = tonumber(t) or 0 end
    })
    Elm.Sect.PlayerDesync:AddTextbox({
        Name = "Offset Z",
        Default = "0",
        TextDisappear = false,
        Callback = function(t) customZ = tonumber(t) or 0 end
    })

    -- хоткей C — тумблит десинк
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.C then
            desyncT.enabled = not desyncT.enabled
            if not desyncT.enabled then Highlight.Enabled = false end
        end
    end)
end

