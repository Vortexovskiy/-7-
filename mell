local PoseSliders = {}
local function MakePoseSliders(gb, key, axis, def, min, max, isRot)
    local s = gb:AddSlider("Pose_" .. key .. "_" .. axis, {
        Text = key .. (isRot and " Rot " or " Offset ") .. axis:upper(),
        Default = def, Min = min, Max = max, Rounding = isRot and 0 or 1, Compact = true,
        Visible = (key == "Head"),
        Callback = function(v)
            if isRot then PoseParams[key]["r" .. string.lower(axis)] = v
            else PoseParams[key]["o" .. string.lower(axis)] = v end
        end,
    })
    PoseSliders[key] = PoseSliders[key] or {}
    PoseSliders[key][axis .. (isRot and "_r" or "_o")] = s
end

