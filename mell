-- PACKET LAG — ExtendGrabLine flood (custom / emoji / sequence / fake)
-- =========================================================================
do
    -- символы для генератора последовательностей
    local symbols = { "𖥶", "ဩ", "𓁷", "〠", "﷽" }

    -- фейк-пакеты под разные софты
    local fakePackets = {
        TheWorst  = { name = "TheWorst",   packets = { "Floppa | floppa loves you", "Floppa | my little floppa", "Floppa | floppa is the best", "Floppa | i love floppa", "Floppa | floppa forever" } },
        Vape      = { name = "Vape",       packets = { "Vape | v4.10 loaded", "Vape | bypass successful", "Vape | injection complete", "Vape | all modules loaded", "Vape | silent aim active" } },
        Synapse   = { name = "Synapse",    packets = { "Synapse X | connected", "Synapse X | script executed", "Synapse X | bypassed", "Synapse X | running", "Synapse X | exploit ready" } },
        Krnl      = { name = "Krnl",       packets = { "Krnl | key validated", "Krnl | injected", "Krnl | executing", "Krnl | success", "Krnl | ready" } },
        ScriptWare= { name = "ScriptWare", packets = { "ScriptWare | loaded", "ScriptWare | ui initialized", "ScriptWare | scripts ready", "ScriptWare | hook installed", "ScriptWare | running" } },
        Electron  = { name = "Electron",   packets = { "Electron | connected", "Electron | bypassed", "Electron | ready", "Electron | executing", "Electron | done" } },
    }

    local packetStrength = 6250
    local sequenceLength = 50
    local customText = ""
    local fakeScriptName = "TheWorst"
    local fakeMessage = ""
    local autoSpamOn = false
    local autoSpamDelay = 0.5

    -- лог в консоль executor'а
    local function log(kind, msg, details)
        local t = os.date("%H:%M:%S")
        print(string.format("[%s] [%s] %s", kind, t, msg))
        if details then print("   └─ " .. details) end
    end

    -- достаём ремоут; nil если игра его не держит
    local function getRemote()
        local GrabEvents = RS:FindFirstChild("GrabEvents")
        if not GrabEvents then
            log("ERROR", "GrabEvents not found", "Remote folder missing")
            return nil
        end
        local ExtendGrabLine = GrabEvents:FindFirstChild("ExtendGrabLine")
        if not ExtendGrabLine then
            log("ERROR", "ExtendGrabLine not found", "Remote event missing")
            return nil
        end
        return ExtendGrabLine
    end

    local function fire(data, label)
        local remote = getRemote()
        if not remote then return false end
        local ok = pcall(function() remote:FireServer(data) end)
        if ok then
            log("SEND", label, string.format("Size: %.2f KB", #data / 1024))
            notify("Packet Sent", string.format("%s | %.2f KB", label, #data / 1024), 2)
        else
            log("ERROR", "FireServer failed", label)
        end
        return ok
    end

    -- 1. кастомный текст
    local function sendCustom(text, strength)
        text = text or customText
        strength = strength or packetStrength
        if not text or text == "" then
            log("WARN", "Empty custom packet", "Enter text first")
            notify("Packet", "Enter text first", 2)
            return false
        end
        return fire(string.rep(text, strength), "Custom packet")
    end

    -- 2. оригинальный эмодзи-флуд
    local function sendOriginal(strength)
        strength = strength or packetStrength
        return fire(string.rep("😂😂😂😂🤣🤣🤣🤣", 100 * strength), "Original emoji packet")
    end

    -- перемешивание индексов
    local function shuffle(tbl)
        for i = #tbl, 2, -1 do
            local j = math.random(i)
            tbl[i], tbl[j] = tbl[j], tbl[i]
        end
        return tbl
    end

    -- генерация последовательности символов
    local function generateSequence(length, randomOrder)
        length = length or sequenceLength
        local seq = {}
        if randomOrder then
            local idx = shuffle({ 1, 2, 3, 4, 5 })
            for i = 1, length do
                table.insert(seq, symbols[idx[((i - 1) % 5) + 1]])
            end
            log("GEN", "Random order sequence", "Order: " .. table.concat(idx, " -> "))
        else
            for i = 1, length do
                table.insert(seq, symbols[((i - 1) % 5) + 1])
            end
            log("GEN", "Cyclic sequence", "Order: 1->2->3->4->5")
        end
        return table.concat(seq)
    end

    -- 3. пакет из сгенерированной последовательности
    local function sendGenerated(randomOrder, strength)
        strength = strength or packetStrength
        local seq = generateSequence(sequenceLength, randomOrder)
        return fire(string.rep(seq, strength), randomOrder and "Random sequence packet" or "Cyclic sequence packet")
    end

    -- 4. фейк-пакет под чужой софт
    local function sendFake(scriptName, strength)
        strength = strength or packetStrength
        local data = fakePackets[scriptName]
        if not data then
            log("ERROR", "Unknown script", tostring(scriptName))
            return false
        end
        local pick = data.packets[math.random(1, #data.packets)]
        log("FAKE", "Faking " .. data.name, pick)
        return fire(string.rep(pick .. " | ", strength), "Fake " .. data.name)
    end

    local function sendAllFake(strength)
        for key in pairs(fakePackets) do
            sendFake(key, strength)
            task.wait(0.2)
        end
        log("FAKE", "All fake packets sent", nil)
    end

    local function sendCustomFake(scriptName, message, strength)
        strength = strength or packetStrength
        if not scriptName or scriptName == "" or not message or message == "" then
            notify("Packet", "Enter script name and message", 2)
