-- =========================================================================
-- TELEPORT TO MOUSE — плавный T, слайдер плавности и мгновенный режим
-- =========================================================================
do
    local tpEnabled = true
    local Mouse = Player:GetMouse()
    local smoothEnabled = true
    local smoothTime = 0.6
    local activeTween = nil
    local lastTweenAt = 0

    Elm.Sect.KeybindsMain:AddToggle({
        Name = "Smooth TP Enabled",
        Default = true,
        Flag = "TPMouseEnabled",
        Callback = function(v) tpEnabled = v end
    })

    Elm.Sect.KeybindsMain:AddToggle({
        Name = "Smooth Teleport (Tween)",
        Default = true,
        Flag = "TPMouseSmoothEnabled",
        Callback = function(v) smoothEnabled = v end
    })

    Elm.Sect.KeybindsMain:AddSlider({
        Name = "Smooth Duration",
        Default = 0.6,
        Min = 0.05,
        Max = 5,
        Increment = 0.05,
        ValueName = "sec",
        Flag = "TPMouseSmoothTime",
        Callback = function(v) smoothTime = v end
    })

    local function doTpMouse()
        if not tpEnabled then return end
        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local ok, hit = pcall(function() return Mouse.Hit end)
        if not ok or not hit then
            notify("TP", "No mouse hit position", 3)
            return
        end

        local targetCF = CFrame.new(hit.Position + Vector3.new(0, 3, 0))
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)

        -- отключаем предыдущий твин, чтобы не было гонки
        if activeTween then
            pcall(function() activeTween:Cancel() end)
            activeTween = nil
        end

        if not smoothEnabled or smoothTime <= 0.01 then
            -- мгновенный телепорт
            hrp.CFrame = targetCF
            return
        end

        -- плавный телепорт через TweenService на RenderService: плавная анимация CFrame
        local TweenService = game:GetService("TweenService")
        local info = TweenInfo.new(smoothTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        activeTween = TweenService:Create(hrp, info, { CFrame = targetCF })
        activeTween:Play()
        -- оставляем небольшой буфер для визуального троттлинга
        lastTweenAt = tick()
    end

    registerBind("tpMouse", getBindKey("tpMouse") ~= Enum.KeyCode.Unknown and getBindKey("tpMouse") or Enum.KeyCode.T, doTpMouse, "Teleport to Mouse")

    -- кнопка реального действия в Main-блоке
    Elm.Sect.KeybindsMain:AddButton({
        Name = "TP to Mouse (now)",
        Callback = doTpMouse
    })
end

-- =========================================================================
-- DOG POSE — V1/V2 сведены в один бинд (в исходнике оба висели на T и Flag)
-- =========================================================================
do
    local dogActive = false
    local dogConn = nil
    local spamChar = nil
    local variant = "V2"

    local function stopDogPose()
        dogActive = false
        if dogConn then dogConn:Disconnect(); dogConn = nil end
        if spamChar and spamChar.Parent then
            for _, v in pairs(spamChar:GetDescendants()) do
                if v:IsA("BasePart") then
                    pcall(function()
                        v.AssemblyLinearVelocity = Vector3.zero
                        v.AssemblyAngularVelocity = Vector3.zero
                    end)
                    v.CanCollide = true
                end
            end
        end
        spamChar = nil
    end

    local function startDogPose()
        local mouse = Player:GetMouse()
        local ok, target = pcall(function() return mouse.Target end)
        if not ok or not target then
            notify("Dog Pose", "No target under mouse", 3)
            return
        end
        local char = target.Parent
        if not char or not char:FindFirstChildOfClass("Humanoid") then
            notify("Dog Pose", "Invalid character target", 3)
            return
        end

        spamChar = char
        dogActive = true

        local sno = XK.grabFolder("SetNetworkOwner")
        local myChar = Player.Character
        local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        notify("Dog Pose", "Locked onto " .. char.Name .. " (" .. variant .. ")", 3)

        dogConn = R.Heartbeat:Connect(function()
            if not dogActive or not hrp or not hrp.Parent or not spamChar or not spamChar.Parent then
                stopDogPose()
                return
            end
            local torso = spamChar:FindFirstChild("Torso") or spamChar:FindFirstChild("UpperTorso")
            local head = spamChar:FindFirstChild("Head")
            local hum = spamChar:FindFirstChildOfClass("Humanoid")
            if not torso or not head then stopDogPose() return end

            if sno then pcall(function() sno:FireServer(head, head.CFrame) end) end
            for _, x in pairs(spamChar:GetDescendants()) do
                if x:IsA("BasePart") then x.CanCollide = false end
            end
            if hum then hum.Health = 100 end   -- не даём физике добить тело

            local lArm = spamChar:FindFirstChild("Left Arm")
            local rArm = spamChar:FindFirstChild("Right Arm")
            local lLeg = spamChar:FindFirstChild("Left Leg")
            local rLeg = spamChar:FindFirstChild("Right Leg")

            if variant == "V1" then
                pcall(function()
                    torso.CFrame = hrp.CFrame * CFrame.new(0, -1, -2) * CFrame.Angles(math.rad(-90), 0, math.rad(180))
                    head.CFrame = torso.CFrame * CFrame.new(0, 1, 0) * CFrame.Angles(math.rad(90), 0, 0)
                    if lArm then lArm.CFrame = torso.CFrame * CFrame.new(-1, 0.5, 0) * CFrame.Angles(math.rad(60), 0, math.rad(-30)) end
                    if rArm then rArm.CFrame = torso.CFrame * CFrame.new(1, 0.5, 0) * CFrame.Angles(math.rad(60), 0, math.rad(30)) end
                    if lLeg then lLeg.CFrame = torso.CFrame * CFrame.new(-0.5, -1, 0) * CFrame.Angles(math.rad(40), 0, 0) end
                    if rLeg then rLeg.CFrame = torso.CFrame * CFrame.new(0.5, -1, 0) * CFrame.Angles(math.rad(40), 0, 0) end
                end)
            else
                pcall(function()
                    torso.CFrame = hrp.CFrame * CFrame.new(0, -1.2, -2.5) * CFrame.Angles(math.rad(-90), 0, 0)
                    head.CFrame = torso.CFrame * CFrame.new(0, 1.3, -0.2) * CFrame.Angles(math.rad(45), 0, 0)
                    if lArm then lArm.CFrame = torso.CFrame * CFrame.new(-0.8, 0.5, 0.5) * CFrame.Angles(math.rad(90), 0, math.rad(20)) end
                    if rArm then rArm.CFrame = torso.CFrame * CFrame.new(0.8, 0.5, 0.5) * CFrame.Angles(math.rad(90), 0, math.rad(-20)) end
                    if lLeg then lLeg.CFrame = torso.CFrame * CFrame.new(-0.6, -1.2, 0.5) * CFrame.Angles(math.rad(90), 0, math.rad(10)) end
                    if rLeg then rLeg.CFrame = torso.CFrame * CFrame.new(0.6, -1.2, 0.5) * CFrame.Angles(math.rad(90), 0, math.rad(-10)) end
                end)
            end
        end)
    end

    local function toggleDog()
        if dogActive then
            stopDogPose()
            notify("Dog Pose", "Deactivated", 2)
        else
            startDogPose()
        end
    end

    Elm.Sect.KeybindsMain:AddDropdown({
        Name = "Dog Pose Variant",
        Options = { "V1", "V2" },
        Default = "V2",
        Callback = function(v)
            variant = v
            if dogActive then stopDogPose(); startDogPose() end
        end
    })

    Elm.Sect.KeybindsMain:AddToggle({
        Name = "Dog Pose (on/off)",
        Default = false,
        Flag = "LoopGrab_Dog",
        Callback = function(v)
            if v then startDogPose() else stopDogPose() end
        end
    })

    _G.MellstroyBinds.register("dogPose", Enum.KeyCode.Z, toggleDog, "Dog Pose")
end

