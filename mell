-- Anti Gucci (Blobman) — стабильный биндер через VehicleSeat
do
    local sys = { on = false, autoRespawn = false, seat = nil, ragConn = nil, sitConn = nil, charConn = nil }

    local function cleanOldToys()
        local inv = XK.myToys()
        if not inv then return end
        for _, toy in pairs(inv:GetChildren()) do
            if toy.Name == "CreatureBlobman" then XK.destroyToy(toy) end
        end
    end

    local function startRagSpam(root)
        if sys.ragConn then sys.ragConn:Disconnect() end
        sys.ragConn = R.Heartbeat:Connect(function()
            if not sys.on or not root then return end
            XK.ragdoll(root, 2)
        end)
    end

    local function startSitSpam(h, seat)
        if sys.sitConn then sys.sitConn:Disconnect() end
        sys.sitConn = R.Heartbeat:Connect(function()
            if not sys.on or not seat or not seat.Parent then return end
            pcall(function() seat:Sit(h) end)
        end)
    end

    local function stopSys()
        sys.on = false
        sys.autoRespawn = false
        sys.seat = nil
        if sys.ragConn then sys.ragConn:Disconnect(); sys.ragConn = nil end
        if sys.sitConn then sys.sitConn:Disconnect(); sys.sitConn = nil end
    end

    local function runStableGucci()
        if sys.on then return end
        local char = Player.Character or Player.CharacterAdded:Wait()
        local h = char:WaitForChild("Humanoid", 3)
        local root = char:WaitForChild("HumanoidRootPart", 3)
        if not (h and root) then sys.on = false return end

        sys.on = true
        cleanOldToys()
        local savedCF = root.CFrame
        XK.spawnToy("CreatureBlobman", CFrame.new(103.85, -7.45, -538.58), Vector3.zero)

        local inv = workspace:WaitForChild(Player.Name .. "SpawnedInToys", 5)
        if not inv then sys.on = false return end

        local blob = nil
        local t = tick()
        while not blob and tick() - t < 3 do
            local target = inv:FindFirstChild("CreatureBlobman")
            if target then
                blob = target
                break
            end
            R.Heartbeat:Wait()
        end
        if not blob then sys.on = false return end

        local head = blob:FindFirstChild("Head")
        if head then head.Anchored = true end

        local seat = blob:WaitForChild("VehicleSeat", 2)
        if not seat then sys.on = false return end
        sys.seat = seat

        startRagSpam(root)
        root.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
        pcall(function() seat:Sit(h) end)
        startSitSpam(h, seat)

        task.wait(0.6)
        h.Sit = false
        h.PlatformStand = true
        pcall(function() seat.Disabled = true end)
        pcall(function() seat:Destroy() end)
        for _, v in pairs(blob:GetDescendants()) do
            if v:IsA("Weld") or v:IsA("Snap") then v:Destroy() end
        end

        root.CFrame = savedCF
        root.AssemblyLinearVelocity = Vector3.zero
        h.PlatformStand = false
        task.wait(0.5)
        if sys.sitConn then sys.sitConn:Disconnect(); sys.sitConn = nil end
        if sys.ragConn then sys.ragConn:Disconnect(); sys.ragConn = nil end
        task.wait(0.5)
        sys.on = false
        notify("Anti Gucci", "Blobman gucci done", 2)
    end

    Elm.Sect.DefenseMain:AddToggle({
        Name = "Anti Gucci (Blobman)",
        Default = false,
        Flag = "AntiGucciBlobman",
        Callback = function(v)
            if v then
                sys.autoRespawn = true
                task.spawn(runStableGucci)
                if not sys.charConn then
                    sys.charConn = Player.CharacterAdded:Connect(function(newChar)
                        if not sys.autoRespawn then return end
                        local h = newChar:WaitForChild("Humanoid", 5)
                        if h then
                            h.Died:Connect(function()
                                if sys.autoRespawn then sys.on = false; cleanOldToys() end
                            end)
                        end
                        task.wait(1)
                        task.spawn(runStableGucci)
                    end)
                end
            else
                stopSys()
                cleanOldToys()
                if sys.charConn then sys.charConn:Disconnect(); sys.charConn = nil end
            end
        end
    })
end

