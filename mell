function RL.Vision.UpdatePlayerESP(player)
    local character = player.Character
    if not character then return end
    local data = RL.Vision.ESPCreated[player]
    local s = RL.Vision.Settings.PlayerESP
    if not data then
        local head = character:WaitForChild("Head", 5)
        if not head then return end
        local hl = Instance.new("Highlight")
        hl.Name = "RSC_PlayerESP"
        hl.Adornee = character
        hl.FillColor = s.FillColor
        hl.OutlineColor = s.OutlineColor
        hl.FillTransparency = s.FillT
        hl.OutlineTransparency = s.OutlineT
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = character
        local bb = Instance.new("BillboardGui")
        bb.Name = "RSC_PlayerName"
        bb.Adornee = head
        bb.Size = UDim2.fromOffset(200, 50)
        bb.StudsOffset = Vector3.new(0, s.NameYOffset, 0)
        bb.AlwaysOnTop = true
        bb.Parent = game.CoreGui
        local lbl = Instance.new("TextLabel")
        lbl.Name = "Label"
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.Text = player.DisplayName .. " (@" .. player.Name .. ")"
        lbl.TextColor3 = s.NameColor
        lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        lbl.TextStrokeTransparency = 0
        lbl.TextSize = s.NameSize
        lbl.TextScaled = false
        lbl.Font = Enum.Font.SourceSansBold
        lbl.Parent = bb
        data = { Highlight = hl, Billboard = bb, Label = lbl, Conn = nil }
        RL.Vision.ESPCreated[player] = data
        data.Conn = character.AncestryChanged:Connect(function(_, parent)
            if not parent then RL.Vision.RemovePlayerESP(player) end
        end)
    end
    data.Highlight.Enabled = s.Enabled
    data.Highlight.FillColor = s.FillColor
    data.Highlight.OutlineColor = s.OutlineColor
    data.Highlight.FillTransparency = s.FillT
    data.Highlight.OutlineTransparency = s.OutlineT
    data.Billboard.Enabled = s.Enabled and s.NameEnabled
    data.Label.TextColor3 = s.NameColor
    data.Label.TextSize = s.NameSize
    data.Billboard.StudsOffset = Vector3.new(0, s.NameYOffset, 0)
end

function RL.Vision.RemovePlayerESP(player)
    local data = RL.Vision.ESPCreated[player]
    if not data then return end
    if data.Conn then data.Conn:Disconnect() end
    if data.Highlight then data.Highlight:Destroy() end
    if data.Billboard then data.Billboard:Destroy() end
    RL.Vision.ESPCreated[player] = nil
end

function RL.Vision.RefreshPlayerESP()
