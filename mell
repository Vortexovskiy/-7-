    -- ===== Fling =====
    do
        local flingOn = false
        local flingTask = nil
        local flingBAV = nil
        local originalPos = nil
        local snapConn = nil
        local flingToggle = nil

        local function clearFling()
            if snapConn then snapConn:Disconnect(); snapConn = nil end
            if flingBAV then flingBAV:Destroy(); flingBAV = nil end
            local char = Player.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    pcall(function()
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    end)
                    if originalPos then hrp.CFrame = originalPos end
                end
            end
        end

        local function setFling(on)
                flingOn = on
                flingTask = cancelTask(flingTask)
                if not on then clearFling() return end

                if not selectedKickPlayer then
                    notify("System", "Select target first!", 3)
                    flingOn = false
                    toggleOff(flingToggle)
                    return
                end

                local myChar = Player.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myRoot then originalPos = myRoot.CFrame end
                notify("Fling", "Fling mode activated", 3)

                -- одно соединение на всю сессию, а не новое каждый тик
                snapConn = R.Heartbeat:Connect(function()
                    if not flingOn then return end
                    local char = Player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local t = selectedKickPlayer
                    local tRoot = t and t.Character and t.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and tRoot and tRoot.Parent then
                        pcall(function()
                            hrp.CFrame = tRoot.CFrame
                            hrp.AssemblyLinearVelocity = Vector3.zero
                        end)
                    end
                end)

                flingTask = task.spawn(function()
                    while flingOn do
                        local char = Player.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        local hum = char and char:FindFirstChildOfClass("Humanoid")
                        if not hrp or not hum then
                            task.wait(0.5)
                            continue
                        end

                        local target = selectedKickPlayer
                        if not target or not target.Parent then
                            flingOn = false
                            toggleOff(flingToggle)
                            break
                        end

                        local tChar = target.Character
                        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

                        if tRoot and tHum and tHum.Health > 0 then
                            if not flingBAV or flingBAV.Parent ~= hrp then
                                if flingBAV then flingBAV:Destroy() end
                                flingBAV = Instance.new("BodyAngularVelocity")
                                flingBAV.Name = "FlingSpin"
                                flingBAV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                                flingBAV.AngularVelocity = Vector3.new(0, 10000, 0)
                                flingBAV.P = 10000
                                flingBAV.Parent = hrp
                            end
                            for _, part in pairs(char:GetDescendants()) do
                                if part:IsA("BasePart") then part.CanCollide = false end
                            end
                        else
                            task.wait(0.2)
                        end
                        task.wait(0.1)
                    end
                    clearFling()
                end)
        end

        flingToggle = Elm.Sect.TargetMain:AddToggle({
            Name = "Fling",
            Default = false,
            Flag = "PlayerFlingBtn",
            Callback = setFling
        })

        -- Bind manager загружается ниже; эта функция остаётся доступной ему.
        _G.MellstroyToggleFling = function()
            setFling(not flingOn)
        end
    end

