function RL.Auras.GetNearbyPlayers(radius)
    local _, myRoot = RL.Char()
    if not myRoot then return {} end
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local _, targetRoot, targetHum = RL.Char(player)
            if targetRoot and targetHum and targetHum.Health > 0 then
                local dist = (targetRoot.Position - myRoot.Position).Magnitude
                if dist <= radius then
                    local inPlot = player:FindFirstChild("InPlot")
                    if not (inPlot and inPlot.Value) then list[#list + 1] = player end
                end
            end
        end
    end
    return list
end

function RL.Auras.ApplyFling(player)
    local _, root = RL.Char(player)
    if not root then return end
    if RL.SNO(root, 0.3) then
        local _, myRoot = RL.Char()
        local dir = myRoot and myRoot.CFrame.LookVector or Vector3.new(0, 1, 0)
        pcall(function() root.AssemblyLinearVelocity = dir * 100 + Vector3.new(0, 25, 0) end)
    end
end

function RL.Auras.ApplySky(player)
