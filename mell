    -- 36 слайдеров: позиция (0.1) и вращение (1) по трём осям на каждую конечность
    local function createLimbSliders(limbLabel, cfgKey)
        for _, axis in ipairs({ "X", "Y", "Z" }) do
            Elm.Sect.GrabOffsets:AddSlider({
                Name = limbLabel .. " Pos " .. axis,
                Flag = "FG_" .. cfgKey .. "Pos" .. axis,
                Default = FGM.Configuration[cfgKey .. "Position"][axis],
                Min = -50, Max = 50, Increment = 0.1,
                ValueName = "studs",
                Callback = function(v) FGM.UpdateConfig(cfgKey .. "Position", axis, v) end
            })
            Elm.Sect.GrabOffsets:AddSlider({
                Name = limbLabel .. " Rot " .. axis,
                Flag = "FG_" .. cfgKey .. "Rot" .. axis,
                Default = FGM.Configuration[cfgKey .. "Rotation"][axis],
                Min = 0, Max = 360, Increment = 1,
                ValueName = "deg",
                Callback = function(v) FGM.UpdateConfig(cfgKey .. "Rotation", axis, v) end
            })
        end
    end

    createLimbSliders("Hold (Torso)", "Hold")
    createLimbSliders("Left Arm", "LeftArm")
    createLimbSliders("Right Arm", "RightArm")
    createLimbSliders("Left Leg", "LeftLeg")
    createLimbSliders("Right Leg", "RightLeg")
    createLimbSliders("Head", "Head")

    _G.MellstroyBinds.register("figureGrab", Enum.KeyCode.V, function()
        FGM.ToggleFigureGrab()
    end, "Figure Grab")
end

-- =========================================================================
-- MISC — plot barriers + hamburger TP
-- =========================================================================
do
    local barrierBackup = {}

    local function disablePlotBarriers()
        local plotsFolder = Workspace:FindFirstChild("Plots")
        if not plotsFolder then
            notify("Error", "Plots folder not found", 3)
            return
        end
        local count = 0
        for _, plot in ipairs(plotsFolder:GetDescendants()) do
            if plot:IsA("BasePart") and plot.Name == "PlotBarrier" then
                -- запоминаем исходное, иначе откат невозможен
                if barrierBackup[plot] == nil then barrierBackup[plot] = plot.CanCollide end
                plot.CanCollide = false
                plot.CanTouch = false
                plot.CanQuery = false
                count = count + 1
            end
        end
        notify("Barriers", count .. " plot barriers disabled", 3)
    end

    local function restorePlotBarriers()
        local count = 0
        for part, state in pairs(barrierBackup) do
            if part and part.Parent then
                part.CanCollide = state
                count = count + 1
            end
        end
        barrierBackup = {}
        notify("Barriers", count .. " plot barriers restored", 3)
    end

    local function hamburgerTeleport()
        local char = Player.Character or Player.CharacterAdded:Wait()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            notify("Error", "HumanoidRootPart not found", 3)
            return
        end

        local originalCFrame = hrp.CFrame
        local MenuToys = RS:FindFirstChild("MenuToys")
        local spawnFn = MenuToys and MenuToys:FindFirstChild("SpawnToyRemoteFunction")
        if not spawnFn then
            notify("Error", "SpawnToyRemoteFunction not found", 3)
            return
        end

        pcall(function() spawnFn:InvokeServer("FoodHamburger", hrp.CFrame, Vector3.zero) end)

        local spawnedToys = XK.myToys()
        if not spawnedToys then
            notify("Error", "SpawnedInToys folder not found", 3)
            return
        end

        local burger = spawnedToys:WaitForChild("FoodHamburger", 5)
        if not burger then
            notify("Error", "Hamburger object not found", 3)
            return
        end

        local holdPart = burger:FindFirstChild("HoldPart")
        local holdFn = holdPart and holdPart:FindFirstChild("HoldItemRemoteFunction")
        if not holdFn then
            notify("Error", "HoldItemRemoteFunction not found", 3)
            return
        end

        pcall(function() holdFn:InvokeServer(burger, char) end)

        local plotsFolder = Workspace:FindFirstChild("Plots")
        local plot3 = plotsFolder and plotsFolder:FindFirstChild("Plot3")
        local plotArea = plot3 and plot3:FindFirstChild("PlotArea")
        if not plotArea then
            notify("Error", "Plot area not found", 3)
            return
        end

        -- телепорт туда-обратно: сервер регистрирует позицию, клиент возвращает
        hrp.CFrame = plotArea.CFrame
        task.wait(0.1)
        if hrp and hrp.Parent then hrp.CFrame = originalCFrame end

        local destroyFn = MenuToys and MenuToys:FindFirstChild("DestroyToy")
        if destroyFn and burger and burger.Parent then
            pcall(function() destroyFn:FireServer(burger) end)
        end
        notify("Hamburger TP", "Teleport loop executed", 3)
    end

    Elm.Sect.MiscMain:AddButton({ Name = "Disable Plot Barriers", Callback = disablePlotBarriers })
    Elm.Sect.MiscMain:AddButton({ Name = "Restore Plot Barriers", Callback = restorePlotBarriers })
    Elm.Sect.MiscMain:AddButton({ Name = "Hamburger Teleport",    Callback = function() task.spawn(hamburgerTeleport) end })
end

