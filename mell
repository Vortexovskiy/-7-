function RL.AC.ApplyPose(character, presetName)
    if not character then return end
    local preset = RL.AC.Poses[presetName]
    if not preset then return end
    for _, partName in ipairs({"Right Arm", "Left Arm", "Right Leg", "Left Leg", "Head", "Torso"}) do
        local part = character:FindFirstChild(partName)
        local data = preset[partName]
        if part and part:IsA("BasePart") and data then
            local oldBG = part:FindFirstChild("RSC_ACBG")
            if not oldBG then
                oldBG = Instance.new("BodyGyro")
                oldBG.Name = "RSC_ACBG"
                oldBG.D = 500
                oldBG.P = 7500
                oldBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                oldBG.Parent = part
            end
            local angle = CFrame.Angles(math.rad(data[1]), math.rad(data[2]), math.rad(data[3]))
            oldBG.CFrame = character:GetPivot() * angle
        end
    end
end

function RL.AC.RemovePose(character)
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        local bg = part:FindFirstChild("RSC_ACBG")
        if bg then bg:Destroy() end
    end
end

function RL.AC.RunLoop()
    while RL.AC.Running and RL.Running do
        local meChar, meRoot = RL.Char()
        if not meChar or not meRoot then task.wait(0.1); continue end
        for player, _ in pairs(RL.AC.Targets) do
            if not RL.AC.Running then break end
            if player.Parent then
                local character, root, humanoid = RL.Char(player)
                if character and root and humanoid and humanoid.Health > 0 then
                    local targetPos = meRoot.CFrame * RL.AC.Offset
                    RL.Grab(root, targetPos)
                    local bp = root:FindFirstChild("RSC_ACBP")
                    if not bp then
                        bp = Instance.new("BodyPosition")
                        bp.Name = "RSC_ACBP"
                        bp.D = 500
                        bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bp.Parent = root
                    end
                    bp.Position = targetPos.Position
                    RL.AC.ApplyPose(character, RL.AC.Preset)
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.LocalTransparencyModifier = RL.AC.Transparency
                        end
                    end
                end
            else
                RL.AC.Targets[player] = nil
            end
        end
        RunService.Heartbeat:Wait()
    end
end

function RL.AC.Clear()
    for player in pairs(RL.AC.Targets) do
        local character, root = RL.Char(player)
        if character then RL.AC.RemovePose(character) end
        if root then
            local bp = root:FindFirstChild("RSC_ACBP")
            if bp then bp:Destroy() end
            RL.RNO(root)
        end
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then part.LocalTransparencyModifier = 0 end
            end
        end
    end
    RL.AC.Targets = {}
end

function RL.AC.SetAngle(partName, axis, value)
    local preset = RL.AC.Poses[RL.AC.Preset]
    if not preset then return end
    local p = preset[partName]
    if not p then return end
    if axis == "X" then p[1] = value
    elseif axis == "Y" then p[2] = value
    elseif axis == "Z" then p[3] = value end
end

function RL.AC.GetAngle(partName, axis)
    local preset = RL.AC.Poses[RL.AC.Preset]
    if not preset then return 0 end
    local p = preset[partName]
    if not p then return 0 end
    if axis == "X" then return p[1]
    elseif axis == "Y" then return p[2]
    elseif axis == "Z" then return p[3] end
    return 0
end

function RL.AC.SaveCustom()
    local preset = RL.AC.Poses[RL.AC.Preset]
    if not preset then return end
    local data = { Angles = {} }
    for _, partName in ipairs(RL.AC.EDIT_PARTS) do
        local p = preset[partName]
        if p then data.Angles[partName] = {p[1], p[2], p[3]} end
    end
    data.Offset = { RL.AC.Offset.X, RL.AC.Offset.Y, RL.AC.Offset.Z }
    if not writefile then
        Library:Notify({ Title = "AntiLose", Description = "writefile not supported!", Duration = 3 })
        return false
    end
    local ok = pcall(function()
        if makefolder and isfolder and not isfolder("AntiLose") then makefolder("AntiLose") end
        writefile("AntiLose/ac_pose.json", HttpService:JSONEncode(data))
    end)
    if ok then
        Library:Notify({ Title = "AntiLose", Description = "Pose saved!", Duration = 3 })
        return true
    end
    Library:Notify({ Title = "AntiLose", Description = "Failed to save pose.", Duration = 3 })
    return false
end

function RL.AC.LoadCustom()
    if not (readfile and isfile and isfile("AntiLose/ac_pose.json")) then
        Library:Notify({ Title = "AntiLose", Description = "No saved pose found.", Duration = 3 })
        return false
    end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile("AntiLose/ac_pose.json"))
    end)
    if not ok or type(data) ~= "table" then
        Library:Notify({ Title = "AntiLose", Description = "Failed to load pose.", Duration = 3 })
        return false
    end
    local preset = RL.AC.Poses["Custom"]
    if not preset then return false end
    if data.Angles then
        for partName, angles in pairs(data.Angles) do
            if preset[partName] and type(angles) == "table" and #angles >= 3 then
                preset[partName] = { angles[1], angles[2], angles[3] }
            end
        end
    end
    if data.Offset then
        RL.AC.Offset = CFrame.new(data.Offset[1] or 0, data.Offset[2] or 0, data.Offset[3] or -5)
    end
    RL.AC.Preset = "Custom"
    if Options.RL_ACPose then Options.RL_ACPose:SetValue("Custom") end
    Library:Notify({ Title = "AntiLose", Description = "Custom pose loaded!", Duration = 3 })
    return true
end

