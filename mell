-- Anti Kick [ITEM] — предмет-якорь на PCLD
do
    local active = false
    local respawnReady = true
    local respawnId = 0
    local myPCLD = nil
    local pcldConn = nil
    local ToyList = {
        ["Japanese Lantern"] = "JapaneseLantern",
        ["Spray Can"] = "SprayCanWD",
        ["Spooky Candle"] = "SpookyCandle1",
    }
    local names = {}
    for k in pairs(ToyList) do table.insert(names, k) end
    table.sort(names)
    local selected = ToyList["Spooky Candle"]

    local function findPCLD(hrp)
        if pcldConn then pcldConn:Disconnect() end
        myPCLD = nil
        pcldConn = R.Heartbeat:Connect(function()
            if myPCLD or not hrp or not hrp.Parent then
                if pcldConn then pcldConn:Disconnect() pcldConn = nil end
                return
            end
            for _, v in pairs(workspace:GetChildren()) do
                if v.Name == "PlayerCharacterLocationDetector" and v:IsA("BasePart") then
                    if (v.Position - hrp.Position).Magnitude <= 2 then
                        myPCLD = v
                        break
                    end
                end
            end
        end)
    end

    local function spawnAnchor(toyName)
        local hrp = XK.root()
        if not hrp then return nil end
        if not XK.canSpawnWait(5) then return nil end
        local cf = (myPCLD or hrp).CFrame * CFrame.new(0, 14, 20)
        local home = XK.findHome()
        local inv = XK.myToys()
        local container = home or inv
        if not container then return nil end
        local got = nil
        local conn = container.ChildAdded:Connect(function(c) if c.Name == toyName then got = c end end)
        local mt = RS:FindFirstChild("MenuToys")
        local s = mt and mt:FindFirstChild("SpawnToyRemoteFunction")
        if s then task.spawn(function() pcall(function() s:InvokeServer(toyName, cf, Vector3.zero) end) end) end
        local t = tick()
        repeat task.wait() until got or (tick() - t) > 2.5
        if conn then conn:Disconnect() end
        return got
    end

    Elm.Sect.DefenseExtra:AddDropdown({
        Name = "Anti Kick Item",
        Options = names,
        Default = "Spooky Candle",
        Callback = function(v) selected = ToyList[v] or selected end
    })

    Elm.Sect.DefenseExtra:AddToggle({
        Name = "Anti Kick [ITEM]",
        Default = false,
        Flag = "AntiKickItemFlag",
        Callback = function(v)
            SetToggleState("AntiKickItemFlag", v)
            active = v
            respawnReady = v
            if v then
                task.spawn(function()
                    while active and task.wait() do
                        if not respawnReady then continue end
                        local char = Player.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        local h = char and char:FindFirstChildOfClass("Humanoid")
                        local inPlot = Player:FindFirstChild("InPlot")
                        local inv = XK.myToys()
                        if not hrp or not h or h.Health <= 0 or not inv then continue end
                        if inPlot and inPlot.Value then continue end
                        if not myPCLD and not pcldConn then findPCLD(hrp) end

                        local item = inv:FindFirstChild("AntiKickItem")
                        local soundPart = item and item:FindFirstChild("Hitbox")

                        if not item or not soundPart then
                            for _, t in pairs(inv:GetChildren()) do
                                if t.Name == "AntiKickItem" then XK.destroyToy(t) end
                            end
                            item = spawnAnchor(selected)
                            if not item then continue end
                            soundPart = item:FindFirstChild("Hitbox") or item:WaitForChild("Hitbox", 0.5)
                            if soundPart then XK.setOwner(soundPart, soundPart.CFrame) end
                            for _, p in pairs(item:GetChildren()) do
                                if p:IsA("BasePart") then
                                    p.CanCollide = false
                                    p.Transparency = 0.8
                                    p.Color = Color3.fromRGB(0, 255, 255)
                                end
                            end
                            item.Name = "AntiKickItem"
                        end

                        if soundPart then
                            local po = soundPart:FindFirstChild("PartOwner")
                            if not po or po.Value ~= Player.Name then
                                XK.setOwner(soundPart, soundPart.CFrame)
                            end
                            local target = myPCLD or hrp:FindFirstChild("FirePlayerPart") or hrp
                            if target then
                                soundPart.CFrame = target.CFrame
                                soundPart.AssemblyLinearVelocity = Vector3.zero
                                soundPart.AssemblyAngularVelocity = Vector3.zero
                            end
                        end
                    end
                end)
            else
                respawnId = respawnId + 1
                if pcldConn then pcldConn:Disconnect(); pcldConn = nil end
                myPCLD = nil
                task.spawn(function()
                    local inv = XK.myToys()
                    if not inv then return end
                    for _, t in pairs(inv:GetChildren()) do
                        if t.Name == "AntiKickItem" then XK.destroyToy(t) end
                    end
                end)
            end
        end
    })

    Player.CharacterAdded:Connect(function(char)
        if not active then return end
        respawnId = respawnId + 1
        local thisRespawn = respawnId
        respawnReady = false
        myPCLD = nil
        if pcldConn then pcldConn:Disconnect(); pcldConn = nil end

        -- Удаляем предмет старого персонажа; основной цикл ждёт ровно 0.5 сек.
        local inv = XK.myToys()
        if inv then
            for _, toy in ipairs(inv:GetChildren()) do
                if toy.Name == "AntiKickItem" then XK.destroyToy(toy) end
            end
        end

        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hrp then return end
        task.wait(0.5)
        if active and thisRespawn == respawnId and char == Player.Character then
            findPCLD(hrp)
            respawnReady = true
        end
    end)
end

