function RL.Char(player)
    player = player or LocalPlayer
    if not player then return end
    local cached = RL.CharCache[player]
    if cached then
        local c, r, h = cached.Character, cached.Root, cached.Humanoid
        if c and c.Parent and r and r.Parent and h and h.Parent then
            return c, r, h
        end
        RL.CharCache[player] = nil
    end
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("realHrp") or character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    RL.CharCache[player] = { Character = character, Root = hrp, Humanoid = humanoid }
    return character, hrp, humanoid
end

function RL.IsPartOwner(part)
    if not (part and part:IsA("BasePart")) then return false end
    local cached = RL.PartOwnerCache[part]
    if cached and cached.Parent then return cached.Value == LocalPlayer.Name end
    local parent = part.Parent
    local head = part.Name == "HumanoidRootPart" and parent and parent:FindFirstChild("Head")
    head = head and head:FindFirstChild("PartOwner")
    if head and head.Value == LocalPlayer.Name then
        RL.PartOwnerCache[part] = head
        return true
    end
    local po = part:FindFirstChild("PartOwner")
    if po and po.Value == LocalPlayer.Name then
        RL.PartOwnerCache[part] = po
        return true
    end
    if parent then
        po = parent:FindFirstChild("PartOwner", true)
        if po then
            RL.PartOwnerCache[part] = po
            return po.Value == LocalPlayer.Name
        end
    end
    return false
end

function RL.Grab(part, cframe)
    if not RL.SetNetworkOwner then return end
    if not (part and part.Parent) then return end
    pcall(function()
        RL.SetNetworkOwner:FireServer(part, cframe or part.CFrame)
    end)
end

function RL.RNO(part)
    if not RL.DestroyGrabLine then return end
    pcall(function()
        RL.DestroyGrabLine:FireServer(part)
    end)
end

function RL.SNO(part, timeout, condition)
    if not part or not part:IsA("BasePart") or not part.Parent then return false end
    if RL.IsPartOwner(part) then return true end
    local deadline = tick() + (timeout or 0.65)
    while RL.Running and part.Parent and not RL.IsPartOwner(part) and tick() < deadline do
        if condition and not condition() then break end
        RL.Grab(part)
        RunService.Heartbeat:Wait()
    end
    return RL.IsPartOwner(part)
end

function RL.ResetVelocity(part)
    if not part or not part:IsA("BasePart") then return end
    pcall(function()
        part.AssemblyLinearVelocity = Vector3.zero
        part.AssemblyAngularVelocity = Vector3.zero
    end)
end

function RL.Teleport(part, cframe)
    if not (part and part:IsA("BasePart") and cframe) then return end
    pcall(function()
        part.CFrame = cframe
        RL.ResetVelocity(part)
    end)
end

function RL.SpawnToy(name, cframe, priority, reserved)
    if not (name and name ~= "") then return end
    if not RL.SpawnToyRemote then return end
    local _, hrp = RL.Char()
    if not hrp then return end
    local spawnCF = cframe or (hrp.CFrame + Vector3.new(0, 15, 0))
    local rotation = Vector3.zero
    local rotateOrient = workspace:FindFirstChild("RotateOrientPart")
    if rotateOrient then rotation = rotateOrient.Rotation end
    local canSpawn = LocalPlayer:FindFirstChild("CanSpawnToy")
    if canSpawn and canSpawn.Value == false then
        local t = tick()
        repeat task.wait() until canSpawn.Value or tick() - t > 3 or not RL.Running
    end
    local folderName = LocalPlayer.Name .. "SpawnedInToys"
    local folder = workspace:FindFirstChild(folderName)
    if not folder then folder = workspace:WaitForChild(folderName, 2) end
    if not folder then return end
    local toy, conn
    conn = folder.ChildAdded:Connect(function(child)
        if child.Name == name then
            toy = child
            if conn then conn:Disconnect() end
        end
    end)
    task.spawn(function()
        pcall(function()
            RL.SpawnToyRemote:InvokeServer(name, CFrame.new(spawnCF.Position) + Vector3.new(0, 0, 20), rotation)
        end)
    end)
    local startWait = tick()
    while not toy and tick() - startWait < 1.3 do
        RunService.Heartbeat:Wait()
    end
    if conn then conn:Disconnect() end
    return toy
end

