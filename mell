function RL.FindNicePart(model)
    if not model or not model:IsA("Model") then return end
    local nice = nil
    for _, part in ipairs(model:QueryDescendants("BasePart")) do
        if part.CanQuery and not part.Anchored and part.Name ~= "Button" then
            nice = nice or part
            if (part.AssemblyRootPart or part) == part then return part end
        end
    end
    return nice
end

function RL.WhichPlot(player)
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return end
    for _, plot in ipairs(plots:GetChildren()) do
        local plotArea = plot:FindFirstChild("PlotArea")
        if plotArea then
            for _, part in ipairs(workspace:GetPartsInPart(plotArea)) do
                if Players:GetPlayerFromCharacter(part.Parent) == player then
                    return plot
                end
            end
        end
    end
end

function RL.BreakPlot(plotOrPlayer)
    if not plotOrPlayer then return end
    local target = plotOrPlayer
    local inPlot = nil
    if target:IsA("Player") then
        inPlot = target:FindFirstChild("InPlot")
        if not inPlot then return end
        target = RL.WhichPlot(target)
        if not target then return end
    end
    if RL.BrokenPlots[target.Name] then return true end
    local plotArea = target:FindFirstChild("PlotArea")
    if not plotArea then return end
    local shuriken = RL.SpawnToy("NinjaShuriken")
    if not shuriken then return end
    local stickyPart = shuriken:WaitForChild("StickyPart", 0.4)
    local stickyWeld = stickyPart and stickyPart:WaitForChild("StickyWeld", 0.4)
    if not (stickyWeld and RL.SNO(stickyPart)) then return end
    local cf = CFrame.new(1099511627776, 1099511627776, 1099511627776)
    if target.Name == "Plot5" then
        cf = CFrame.new(2147483648, 2147483648, 2147483648)
    end
    pcall(function()
        RL.StickyPartEvent:FireServer(stickyPart, plotArea, cf)
    end)
    local t0 = tick()
    while tick() - t0 < 0.8 do
        if stickyWeld.Part1 == plotArea then break end
        if not stickyWeld.Parent then break end
        if inPlot and inPlot.Value then break end
        task.wait()
    end
    if not stickyWeld.Parent or stickyWeld.Part1 ~= plotArea then
        RL.DestroyToy(shuriken)
        return false
    end
    RL.BrokenPlots[target.Name] = shuriken
    shuriken.Destroying:Once(function()
        RL.BrokenPlots[target.Name] = nil
    end)
    return shuriken
end

function RL.FindCheaters()
    local found = {}
    local function hasStickyPart(part)
        if not (part and part.Parent) then return false end
        for _, connected in ipairs(part:GetConnectedParts()) do
            if connected.Name == "StickyPart" then return true end
        end
        return false
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local hrp = character:FindFirstChild("HumanoidRootPart")
                if humanoid and hrp then
                    local seatPart = humanoid.SeatPart
                    if seatPart then
                        local seatWeld = seatPart:FindFirstChild("SeatWeld")
                        if not seatWeld or not seatWeld.Enabled then
                            found[player] = "Has Gucci"
                        end
                    end
                    if not found[player] then
                        local ragdollTouched = hrp:FindFirstChild("RagdollTouchedHitbox")
                        local firePlayerPart = hrp:FindFirstChild("FirePlayerPart")
                        if hasStickyPart(hrp) or hasStickyPart(ragdollTouched) or hasStickyPart(firePlayerPart) then
                            found[player] = "Shuriken in HRP"
                        end
                    end
                end
            end
        end
    end
    if not next(found) then
        Library:Notify({ Title = "AntiLose", Description = "Cheaters not found!", Duration = 3 })
        return
    end
    local msg = "Cheaters Found\n\n"
    for player, reason in pairs(found) do
        msg = msg .. ("[%s (@%s)]\n%s\n\n"):format(player.DisplayName, player.Name, reason)
    end
    Library:Notify({ Title = "AntiLose", Description = msg:sub(1, -3), Duration = 8 })
end

