-- VISUALS TAB — PCLD ESP (tween-smoothed, SelectionBox outline, RGB + rainbow)
-- =========================================================================
do
    local TweenService = game:GetService("TweenService")

    local smoothPCLDs = {}
    local pcldPlayerCache = {}
    local cons = {}

    local espR, espG, espB = 255, 60, 60
    local espColor = Color3.fromRGB(espR, espG, espB)
    local smoothTime = 0.18
    local rainbowPCLD = false
    local nameTagsOn = false
    local espOn = false

    -- ближайший игрок к детектору; кэш на 2с, чтобы имя не мигало
    local function getPlayerFromPCLD(pcld)
        local closest, closestDist = nil, 10
        for _, player in ipairs(PS:GetPlayers()) do
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - pcld.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = player
                end
            end
        end
        if closest then
            pcldPlayerCache[pcld] = { player = closest, time = tick() }
            return closest.DisplayName .. " (@" .. closest.Name .. ")"
        end
        local cached = pcldPlayerCache[pcld]
        if cached and tick() - cached.time < 2 and cached.player then
            return cached.player.DisplayName .. " (@" .. cached.player.Name .. ")"
        end
        return "Unknown"
    end

    local function paintAll(c)
        for _, d in pairs(smoothPCLDs) do
            if d.box then d.box.Color = c end
            if d.outline then d.outline.Color3 = c end
        end
    end

    local function createSmoothPCLD(original)
        if smoothPCLDs[original] then return end
        original.Transparency = 1

        local box = Instance.new("Part")
        box.Name = "PCLD_Box"
        box.Size = original.Size
        box.CFrame = original.CFrame
        box.Anchored = true
        box.CanCollide = false
        box.CanTouch = false
        box.CanQuery = false
        box.CastShadow = false
        box.Material = Enum.Material.Neon
        box.Color = espColor
        box.Transparency = 0.45
        box.Parent = Workspace

        local outline = Instance.new("SelectionBox")
        outline.Adornee = box
        outline.LineThickness = 0.02
        outline.Color3 = espColor
        outline.Transparency = 0.1
        outline.Parent = box

        local data = { box = box, outline = outline, original = original, tween = nil, gui = nil, label = nil }
        smoothPCLDs[original] = data

        -- твинг позиции: детектор дёргается сервером, бокс едет плавно
        task.spawn(function()
            local lastPos = original.Position
            while box.Parent and original.Parent do
                local pos = original.Position
                local cf = original.CFrame
                if (pos - lastPos).Magnitude > 0.02 then
                    lastPos = pos
                    if data.tween then pcall(function() data.tween:Cancel() end) end
                    data.tween = TweenService:Create(box, TweenInfo.new(smoothTime, Enum.EasingStyle.Linear), { CFrame = cf })
                    data.tween:Play()
                end
                if nameTagsOn then
                    if not data.label then
                        local gui = Instance.new("BillboardGui")
                        gui.Adornee = box
                        gui.Size = UDim2.new(0, 200, 0, 24)
                        gui.StudsOffset = Vector3.new(0, box.Size.Y / 2 + 0.6, 0)
                        gui.AlwaysOnTop = true
                        gui.LightInfluence = 0
                        gui.Parent = box
                        local lbl = Instance.new("TextLabel")
                        lbl.BackgroundTransparency = 1
                        lbl.Size = UDim2.new(1, 0, 1, 0)
                        lbl.Font = Enum.Font.GothamBold
                        lbl.TextSize = 14
                        lbl.TextStrokeTransparency = 0.4
                        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                        lbl.Parent = gui
                        data.gui, data.label = gui, lbl
                    end
                    pcall(function() data.label.Text = getPlayerFromPCLD(original) end)
                elseif data.gui then
                    data.gui:Destroy()
                    data.gui, data.label = nil, nil
                end
                task.wait(0.03)
            end
        end)
    end

    local function removeSmoothPCLD(original)
        local d = smoothPCLDs[original]
        if not d then return end
        if d.tween then pcall(function() d.tween:Cancel() end) end
        if d.box then d.box:Destroy() end
        smoothPCLDs[original] = nil
        pcldPlayerCache[original] = nil
    end

    local function clearAll()
        for _, d in pairs(smoothPCLDs) do
            if d.tween then pcall(function() d.tween:Cancel() end) end
            if d.box then d.box:Destroy() end
        end
        smoothPCLDs = {}
        pcldPlayerCache = {}
    end

    Elm.Sect.VisualsMain:AddToggle({
        Name = "PCLD ESP",
        Default = false,
        Flag = "ViewPCLD",
        Callback = function(v)
            espOn = v
            if v then
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj.Name == "PlayerCharacterLocationDetector" then createSmoothPCLD(obj) end
                end
                cons.view = Workspace.ChildAdded:Connect(function(child)
                    if child.Name == "PlayerCharacterLocationDetector" then
                        task.wait(0.1)
                        createSmoothPCLD(child)
                    end
                end)
                cons.removed = Workspace.ChildRemoved:Connect(function(child)
                    if child.Name == "PlayerCharacterLocationDetector" then removeSmoothPCLD(child) end
                end)
            else
                if cons.view then cons.view:Disconnect(); cons.view = nil end
                if cons.removed then cons.removed:Disconnect(); cons.removed = nil end
                clearAll()
            end
        end
    })

    Elm.Sect.VisualsMain:AddToggle({
        Name = "PCLD Name Tags",
        Default = false,
        Flag = "PCLDNameTags",
        Callback = function(v) nameTagsOn = v end
    })

    Elm.Sect.VisualsMain:AddSlider({
        Name = "ESP Red", Default = 255, Min = 0, Max = 255, Increment = 1,
        Flag = "PCLDColorR",
        Callback = function(v)
            espR = v
            if not rainbowPCLD then espColor = Color3.fromRGB(espR, espG, espB) paintAll(espColor) end
        end
    })
    Elm.Sect.VisualsMain:AddSlider({
        Name = "ESP Green", Default = 60, Min = 0, Max = 255, Increment = 1,
        Flag = "PCLDColorG",
        Callback = function(v)
            espG = v
            if not rainbowPCLD then espColor = Color3.fromRGB(espR, espG, espB) paintAll(espColor) end
        end
    })
    Elm.Sect.VisualsMain:AddSlider({
        Name = "ESP Blue", Default = 60, Min = 0, Max = 255, Increment = 1,
        Flag = "PCLDColorB",
        Callback = function(v)
            espB = v
            if not rainbowPCLD then espColor = Color3.fromRGB(espR, espG, espB) paintAll(espColor) end
        end
    })

    Elm.Sect.VisualsMain:AddSlider({
        Name = "Smooth Time", Default = 0.18, Min = 0.02, Max = 1, Increment = 0.02,
        ValueName = "sec", Flag = "PCLDSmoothTime",
        Callback = function(v) smoothTime = v end
    })

    Elm.Sect.VisualsMain:AddToggle({
        Name = "PCLD Rainbow",
        Default = false,
        Flag = "RainbowPCLD",
        Callback = function(v)
            rainbowPCLD = v
            if v then
                task.spawn(function()
                    while rainbowPCLD do
                        paintAll(Color3.fromHSV(tick() % 1, 1, 1))
                        task.wait(0.05)
                    end
                end)
            else
                espColor = Color3.fromRGB(espR, espG, espB)
                paintAll(espColor)
            end
        end
    })
end

