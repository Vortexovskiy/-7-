-- Anti Gucci (Train)
do
    local trainOn = false
    local conn = nil
    local safePos = nil
    local restoreFrames = 0

    local function startTrain()
        local char = Player.Character or Player.CharacterAdded:Wait()
        local h = char:WaitForChild("Humanoid", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not (h and hrp) then return end
        safePos = hrp.Position

        local folder = workspace:FindFirstChild("Map")
        folder = folder and folder:FindFirstChild("AlwaysHereTweenedObjects")
        local train = folder and folder:FindFirstChild("Train")
        local seat = nil
        if train then
            for _, d in ipairs(train:GetDescendants()) do
                if d:IsA("Seat") then
                    seat = d
                    break
                end
            end
        end
        if not seat then notify("Gucci Train", "No seat on train", 3) return end

        hrp.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
        pcall(function() seat:Sit(h) end)

        h:GetPropertyChangedSignal("Jump"):Connect(function()
            if h.Jump and h.Sit then
                restoreFrames = 15
                safePos = hrp.Position
            end
        end)

        if conn then conn:Disconnect() end
        conn = R.Heartbeat:Connect(function()
            if not hrp or not hrp.Parent or not h then return end
            XK.ragdoll(hrp, 0)
            if restoreFrames > 0 then
                hrp.CFrame = CFrame.new(safePos)
                restoreFrames = restoreFrames - 1
            end
        end)
    end

    local function stopTrain()
        if conn then conn:Disconnect(); conn = nil end
        local char = Player.Character
        local h = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if h then
            h.Sit = false
            pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        if hrp and safePos then hrp.CFrame = CFrame.new(safePos) end
    end

    Elm.Sect.DefenseMain:AddToggle({
        Name = "Anti Gucci (Train)",
        Default = false,
        Flag = "AntiGucciTrain",
        Callback = function(v)
            SetToggleState("Anti Gucci (Train)", v)
            trainOn = v
            if v then
                startTrain()
                notify("System", "Gucci active (monitoring)", 3)
                task.spawn(function()
                    while trainOn do
                        local folder = workspace:FindFirstChild("Map")
                        folder = folder and folder:FindFirstChild("AlwaysHereTweenedObjects")
                        local train = folder and folder:FindFirstChild("Train")
                        if not train then
                            stopTrain()
                            notify("System", "Train lost", 3)
                            local retries = 0
                            repeat
                                task.wait(0.2)
                                retries = retries + 1
                                folder = workspace:FindFirstChild("Map")
                                folder = folder and folder:FindFirstChild("AlwaysHereTweenedObjects")
                            until (folder and folder:FindFirstChild("Train")) or retries > 25 or not trainOn
                            if trainOn and folder and folder:FindFirstChild("Train") then
                                startTrain()
                                notify("System", "Train restored", 3)
                            end
                        end
                        task.wait(0.5)
                    end
                end)
            else
                stopTrain()
                notify("System", "Gucci disabled", 3)
            end
        end
    })
end

