local function immunityAntiKick(player)
    local character, root = RL.Char(player)
    if not character or not root then return end
    local function tryRemove(part)
        if not (part and part.Parent) then return end
        local sticky = part:FindFirstChild("StickyPart")
        if not sticky then return end
        RL.Grab(sticky)
        if RL.SNO(sticky, 0.15) then
            sticky.CFrame = CFrame.new(0, 5000, 0)
            task.delay(0.3, function() RL.RNO(sticky) end)
        end
    end
    tryRemove(root)
    tryRemove(root:FindFirstChild("RagdollTouchedHitbox"))
    tryRemove(root:FindFirstChild("FirePlayerPart"))
end

local function immunityAntiGrab(player)
    local character, root = RL.Char(player)
    if not character or not root then return end
    local head = character:FindFirstChild("Head")
    local po = head and head:FindFirstChild("PartOwner")
    if po and po.Value and po.Value ~= "" and po.Value ~= player.Name then
        local saved = RL.Immunity.GrabState[player]
        if not saved then return end
        if RL.SNO(root, 0.3) then
            root.CFrame = saved
            RL.ResetVelocity(root)
            task.delay(0.2, function() RL.RNO(root) end)
        end
    else
        RL.Immunity.GrabState[player] = root.CFrame
    end
end

workspace.ChildAdded:Connect(function(child)
    if not RL.Immunity.Settings.AntiExplosion then return end
    if child.Name ~= "Part" or not child:IsA("BasePart") then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if RL.Immunity.Players[player] then
            local _, root = RL.Char(player)
            if root and (child.Position - root.Position).Magnitude <= 20 then
                if RL.SNO(root, 0.3) then
                    local away = (root.Position - child.Position)
                    if away.Magnitude < 0.01 then away = Vector3.new(0, 1, 0) end
                    RL.Teleport(root, root.CFrame + away.Unit * 30)
                    task.delay(0.2, function() RL.RNO(root) end)
                end
            end
        end
    end
end)

function RL.Immunity.RunLoop()
    while RL.Running and next(RL.Immunity.Players) ~= nil do
        local s = RL.Immunity.Settings
        local anyActive = s.AntiGrab or s.AntiKick
        if not anyActive then task.wait(0.1); continue end
        for player, _ in pairs(RL.Immunity.Players) do
            if player.Parent then
                if s.AntiKick then pcall(immunityAntiKick, player) end
                if s.AntiGrab then pcall(immunityAntiGrab, player) end
            else
                RL.Immunity.Players[player] = nil
                RL.Immunity.GrabState[player] = nil
            end
        end
        task.wait(s.TickRate)
    end
end

function RL.Immunity.ClearAll()
    for player in pairs(RL.Immunity.Players) do RL.Immunity.GrabState[player] = nil end
    RL.Immunity.Players = {}
end

