                end)
                local t = tick() + 5
                repeat task.wait(0.05) until myToys:FindFirstChild("PalletLightBrown") or tick() > t
                pallet = myToys:FindFirstChild("PalletLightBrown")
            end
            if not pallet then return end

            pallet.Name = "RagdollPallet"
            local soundPart = pallet:WaitForChild("SoundPart", 5)
            if not soundPart then return end

            local t2 = tick() + 3
            repeat
                if FGM.SetNetworkOwner then
                    pcall(function() FGM.SetNetworkOwner:FireServer(soundPart, soundPart.CFrame) end)
                end
                task.wait()
            until soundPart:FindFirstChild("PartOwner") or tick() > t2

            pcall(function() soundPart.AssemblyLinearVelocity = Vector3.new(0, 10000, 0) end)
            for _, v in pairs(pallet:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Transparency = 1
                    v.CanCollide = false
                end
            end

            FGM.State.RagdollPallet = pallet
            FGM.State.RagdollSoundPart = soundPart

            FGM.State.AutoRagdollConnection = R.Heartbeat:Connect(function()
                if not FGM.State.AutoRagdollEnabled then return end
                local sp = FGM.State.RagdollSoundPart
                if not sp or not sp.Parent then
                    if FGM.State.AutoRagdollConnection then
                        FGM.State.AutoRagdollConnection:Disconnect()
                        FGM.State.AutoRagdollConnection = nil
                    end
                    FGM.State.RagdollPallet = nil
                    FGM.State.RagdollSoundPart = nil
                    return
                end

                local targets = {}
                if FGM.State.FigureGrabEnabled and FGM.State.TargetCharacter then
                    table.insert(targets, FGM.State.TargetCharacter)
                end
                if FGM.State.SeveralEnabled then
                    for _, e in ipairs(FGM.State.SeveralTargets) do table.insert(targets, e.char) end
                end

                for _, targetChar in ipairs(targets) do
                    if targetChar and targetChar.Parent then
                        local hrp = targetChar:FindFirstChild("HumanoidRootPart")
                        local hum = targetChar:FindFirstChildOfClass("Humanoid")
                        if hrp and hum then
                            local ragdolled = hum:FindFirstChild("Ragdolled")
                            if ragdolled and ragdolled.Value == false then
                                task.spawn(function()
                                    pcall(function()
                                        sp.AssemblyLinearVelocity = Vector3.new(0, 100, 0)
                                        sp.CFrame = hrp.CFrame
                                    end)
                                    task.wait(0.05)
                                    if sp and sp.Parent then
                                        pcall(function() sp.CFrame = CFrame.new(0, 1e9, 0) end)
                                    end
                                end)
                            end
                        end
                    end
                end
            end)
        end)
    end

    function FGM.ToggleFigureGrab()
        if not FGM.State.FigureGrabEnabled then
            local ok, mouseTarget = pcall(function() return FGM.Mouse.Target end)
            if not ok or not mouseTarget then
                notify("Figure Grab", "Aim at a player first", 3)
                return
            end

            local targetChar = mouseTarget.Parent
            local MyCharacter = FGM.GetCharacter(Player)
            if not targetChar or not MyCharacter then
                notify("Figure Grab", "Invalid target", 3)
                return
            end

            local TargetTorso = targetChar:FindFirstChild("Torso")
            if not TargetTorso then
                notify("Figure Grab", "Torso not found (R15?)", 3)
                return
            end

            FGM.State.TargetCharacter = targetChar
            local BodyParts = { "Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }
            for _, partName in ipairs(BodyParts) do
                local part = targetChar:FindFirstChild(partName)
                if part then
                    part.Anchored = false
                    part.CanCollide = true
                    part.Massless = true
                end
            end

            FGM.State.FigureGrabEnabled = true
            FGM.Configuration.LineDistance = 5

            if FGM.State.FigureGrabConnection then FGM.State.FigureGrabConnection:Disconnect() end

            FGM.State.FigureGrabConnection = R.Heartbeat:Connect(function()
                local tc = FGM.State.TargetCharacter
                if not tc or not tc.Parent or not MyCharacter or not MyCharacter.Parent then
                    FGM.State.FigureGrabEnabled = false
                    if FGM.State.FigureGrabConnection then
                        FGM.State.FigureGrabConnection:Disconnect()
                        FGM.State.FigureGrabConnection = nil
                    end
                    return
                end

                local MyRoot = MyCharacter:FindFirstChild("HumanoidRootPart")
                if not MyRoot then return end
                local torso = tc:FindFirstChild("Torso")
                if not torso then return end

                local cfg = FGM.Configuration
                local holdCFrame = MyRoot.CFrame * CFrame.new(cfg.HoldPosition.X, cfg.HoldPosition.Y, cfg.HoldPosition.Z)
                pcall(function()
                    torso.CFrame = holdCFrame * CFrame.Angles(
                        math.rad(cfg.HoldRotation.X), math.rad(cfg.HoldRotation.Y), math.rad(cfg.HoldRotation.Z))
                end)
                zeroMotion(torso)

                if FGM.State.AnimationCopyEnabled then
                    FGM.CopyAnimationsFromLimbs()
                else
                    for _, partName in ipairs(BodyParts) do
                        local part = tc:FindFirstChild(partName)
                        if part and part ~= torso then
                            local key = partName:gsub(" ", "")
                            local posKey, rotKey = key .. "Position", key .. "Rotation"
                            if cfg[posKey] and cfg[rotKey] then
                                pcall(function()
                                    part.CFrame = torso.CFrame
                                        * CFrame.new(cfg[posKey].X, cfg[posKey].Y, cfg[posKey].Z)
                                        * CFrame.Angles(math.rad(cfg[rotKey].X), math.rad(cfg[rotKey].Y), math.rad(cfg[rotKey].Z))
                                end)
                                zeroMotion(part)
                            end
                        end
                    end
                end

                -- раньше сюда летел mouseTarget, пойманный один раз при включении
                if FGM.SetNetworkOwner then
                    pcall(function() FGM.SetNetworkOwner:FireServer(torso, holdCFrame) end)
                end
            end)

            if FGM.State.AutoRagdollToggle then FGM.ToggleAutoRagdoll(true) end
            notify("Figure Grab", "Activated on " .. targetChar.Name, 3)
        else
            FGM.State.FigureGrabEnabled = false
            FGM.State.AnimationCopyEnabled = false
            if FGM.State.FigureGrabConnection then
                FGM.State.FigureGrabConnection:Disconnect()
                FGM.State.FigureGrabConnection = nil
            end
            FGM.ToggleAutoRagdoll(false)
            notify("Figure Grab", "Deactivated", 3)
        end
    end

    function FGM.ResetPose()
        for _, values in pairs(FGM.Configuration) do
            if typeof(values) == "table" then
                for axis in pairs(values) do values[axis] = 0 end
            end
        end
    end

    function FGM.ApplyPreset(presetName)
        local preset = FGM.Presets[presetName]
        if not preset then return end
        for section, values in pairs(preset) do
            if FGM.Configuration[section] then
                for axis, value in pairs(values) do
                    FGM.Configuration[section][axis] = value
                end
            end
        end
        notify("Figure Grab", "Preset applied: " .. presetName, 2)
    end

    function FGM.UpdateConfig(section, axis, value)
        if FGM.Configuration[section] and FGM.Configuration[section][axis] ~= nil then
            FGM.Configuration[section][axis] = value
        end
    end

    -- ===== UI: Grab tab =====
    -- кнопка, а не тугл: состояние живёт в FGM.State, тугл бы ему врал
    Elm.Sect.GrabMain:AddButton({
