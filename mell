            statsConnection = nil
        end
        if statsGui then
            statsGui:Destroy()
            statsGui = nil
            statsLabel = nil
        end
    end

    local function createStatsHud()
        destroyStatsHud()

        statsGui = Instance.new("ScreenGui")
        statsGui.Name = "MellstroyPerformanceHUD"
        statsGui.ResetOnSpawn = false
        statsGui.IgnoreGuiInset = true
        statsGui.DisplayOrder = 999
        statsGui.Parent = Player:WaitForChild("PlayerGui")

