    -- ===== Destroy Gucci (sit) — выдёргивает цель из её же блоба =====
    do
        local dgOn = false
        local dgTask = nil
        local dgToggle = nil

        dgToggle = Elm.Sect.TargetExtra:AddToggle({
            Name = "Destroy Gucci (sit)",
            Default = false,
            Flag = "DestroyTargetGucci",
            Callback = function(v)
                dgOn = v
                dgTask = cancelTask(dgTask)
                if not v then
                    notify("System", "Destroy Gucci off", 2)
                    return
                end

                if not selectedKickPlayer then
                    notify("Error", "Select target first", 3)
                    dgOn = false
                    toggleOff(dgToggle)
                    return
                end

                local char = Player.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                local SafeSpot = root.CFrame
                local folderName = selectedKickPlayer.Name .. "SpawnedInToys"
                notify("System", "Watching " .. folderName, 3)

                dgTask = task.spawn(function()
                    while dgOn do
                        local target = selectedKickPlayer
                        if not target or not target.Parent then
                            notify("System", "Target gone", 3)
                            dgOn = false
                            toggleOff(dgToggle)
                            break
                        end

                        local toysFolder = workspace:FindFirstChild(folderName)
                        if not toysFolder then
                            task.wait(1)
                        else
                            for _, obj in ipairs(toysFolder:GetChildren()) do
                                if not dgOn then break end
                                if obj.Name == "CreatureBlobman" then
                                    local seat = obj:FindFirstChild("VehicleSeat") or obj:FindFirstChildWhichIsA("VehicleSeat", true)
                                    if seat then
                                        local myChar = Player.Character
                                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                                        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
                                        if myRoot and myHum and myHum.SeatPart ~= seat then
                                            notify("Target", "Magnetizing to seat", 1)
                                            local magnet = R.Stepped:Connect(function()
                                                if myRoot and myRoot.Parent and seat and seat.Parent then
                                                    pcall(function()
                                                        myRoot.CFrame = seat.CFrame
                                                        myRoot.AssemblyLinearVelocity = Vector3.zero
                                                    end)
                                                    local pp = obj.PrimaryPart
                                                    if pp then
                                                        pcall(function()
                                                            pp.AssemblyLinearVelocity = Vector3.zero
                                                            pp.AssemblyAngularVelocity = Vector3.zero
                                                        end)
                                                    end
                                                end
                                            end)

                                            local sitStart = tick()
                                            while tick() - sitStart < 1 do
                                                if not dgOn then break end
                                                if myHum.SeatPart == seat then break end
                                                pcall(function() seat:Sit(myHum) end)
                                                task.wait()
                                            end

                                            if magnet then magnet:Disconnect() end

                                            if myHum.SeatPart == seat then
                                                task.wait(0.3)
                                                myHum.Sit = false
                                                myHum.Jump = true
                                                task.wait(0.05)
                                                if myRoot and myRoot.Parent then
                                                    pcall(function()
                                                        myRoot.CFrame = SafeSpot
                                                        myRoot.AssemblyLinearVelocity = Vector3.zero
                                                    end)
                                                end
                                                notify("Success", "Gucci removed", 1)
                                                task.wait(0.5)
                                            elseif myRoot and myRoot.Parent then
                                                myRoot.CFrame = SafeSpot
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        task.wait(1)
                    end
                end)
            end
        })
    end
