local XK = {}
do
    function XK.grabFolder(name)
        local f = RS:FindFirstChild("GrabEvents")
        return f and f:FindFirstChild(name)
    end
    function XK.charFolder(name)
        local f = RS:FindFirstChild("CharacterEvents")
        return f and f:FindFirstChild(name)
    end
    function XK.root()
        local c = Player.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end
    function XK.hum()
        local c = Player.Character
        return c and c:FindFirstChildOfClass("Humanoid")
    end
    function XK.ragdoll(r, n)
        local ev = XK.charFolder("RagdollRemote")
        if ev and r then pcall(function() ev:FireServer(r, n or 0) end) end
    end
    function XK.setOwner(part, cf)
        local ev = XK.grabFolder("SetNetworkOwner")
        if ev and part then pcall(function() ev:FireServer(part, cf or part.CFrame) end) end
    end
    function XK.myToys()
        return workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
    end
    function XK.destroyToy(model)
        local mt = RS:FindFirstChild("MenuToys")
        local d = mt and mt:FindFirstChild("DestroyToy")
        if d and model then pcall(function() d:FireServer(model) end) end
    end
    function XK.spawnToy(name, cf, vel)
        local mt = RS:FindFirstChild("MenuToys")
        local s = mt and mt:FindFirstChild("SpawnToyRemoteFunction")
        if not s then return nil end
        local inv = XK.myToys()
        local got = nil
        local conn = inv and inv.ChildAdded:Connect(function(c) if c.Name == name then got = c end end)
        task.spawn(function() pcall(function() s:InvokeServer(name, cf or CFrame.new(), vel or Vector3.zero) end) end)
        local t = tick()
        repeat task.wait() until got or (tick() - t) > 3
        if conn then conn:Disconnect() end
        return got
    end
    function XK.findHome()
        local plots = workspace:FindFirstChild("Plots")
        local plotItems = workspace:FindFirstChild("PlotItems")
        if not plots or not plotItems then return nil end
        for _, v in pairs(plots:GetChildren()) do
            local sign = v:FindFirstChild("PlotSign")
            local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
            if owners then
                for _, b in pairs(owners:GetChildren()) do
                    if b.Value == Player.Name then
                        local folder = plotItems:FindFirstChild(v.Name)
                        if folder then return folder end
                    end
                end
            end
        end
        return nil
    end
    function XK.canSpawnWait(timeout)
        local f = Player:FindFirstChild("CanSpawnToy")
        if not f then return true end
        local t = tick()
        while not f.Value and tick() - t < (timeout or 5) do task.wait(0.05) end
        return f.Value
    end
end

