    Elm.Sect.GrabPoses:AddButton({ Name = "Reset Pose",        Callback = function() FGM.ResetPose() end })
    Elm.Sect.GrabPoses:AddButton({ Name = "Pose 1 Jesus",      Callback = function() FGM.ApplyPreset("Pose1") end })
    Elm.Sect.GrabPoses:AddButton({ Name = "Pose 2 Dog",        Callback = function() FGM.ApplyPreset("Pose2") end })
    Elm.Sect.GrabPoses:AddButton({ Name = "Pose 3 L",          Callback = function() FGM.ApplyPreset("Pose3") end })
