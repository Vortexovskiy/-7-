-- единый диспетчер: одна точка входа, все сравниваем через реестр, без снимков.
UserInputService.InputBegan:Connect(function(input, gpe)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local key = input.KeyCode

    -- 1. UI-toggle: проверяется до gpe, это системная клавиша
    if key == uiToggleKey then
        toggleUIBlueprint()
        return
    end

    -- 2. Остальные — только если не вводим текст
    if gpe then return end
    for name, def in pairs(BindRegistry) do
        if def.key == key then
            -- снимок action на момент вызова, не используем def.action из registry closure
            local fn = BindActions[name] or (type(def.action) == "function" and def.action)
            if fn then
                pcall(fn)
            end
            break
        end
    end
end)

