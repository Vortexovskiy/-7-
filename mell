-- авто-обновление списка Select Target: события + периодический скан
do
    local lastSig = ""

    -- сигнатура списка, чтобы рефрешить только при реальном изменении
    local function listSignature(list)
        table.sort(list)
        return table.concat(list, "|")
    end

    local function refreshTargets(force)
        local list = getPlayerList()
        local sig = listSignature(list)
        if not force and sig == lastSig then return end
        lastSig = sig

        -- сохраняем выбор, если игрок ещё в игре
        local keep = selectedKickPlayer and selectedKickPlayer.Parent and selectedKickPlayer.Name or nil
        -- BetterOrion с false дописывает новые options к старым. true сначала очищает список,
        -- поэтому игроки больше не дублируются после ручного/автоматического refresh.
        PlayerDropdown:Refresh(list, true)
        if keep and PS:FindFirstChild(keep) then
            pcall(function() PlayerDropdown:Set(keep) end)
            selectedKickPlayer = PS:FindFirstChild(keep)
        elseif keep and not PS:FindFirstChild(keep) then
            selectedKickPlayer = nil  -- цель вышла — сбрасываем
        end
    end

    Elm.Sect.TargetMain:AddButton({
        Name = "Refresh Player List",
        Callback = function()
            refreshTargets(true)
            notify("Target List", "Player list refreshed: " .. tostring(#getPlayerList()), 2)
        end
    })

    PS.PlayerAdded:Connect(function()
        refreshTargets(false)
    end)
    PS.PlayerRemoving:Connect(function()
        task.defer(function()
            refreshTargets(false)  -- ждём, пока игрок реально уйдёт из списка
        end)
    end)

    -- периодический скан ловит смену ников и промахи событий
    task.spawn(function()
        while true do
            task.wait(2)
            refreshTargets(false)
        end
    end)

    refreshTargets(true)
end

-- =========================================================================
-- CUSTOM BLACK HOLE — отдельная функция-фабрика
-- _G.CustomBlackHole(cfg) -> объект с :SetImage :MoveTo :AttachBeam :Destroy
-- =========================================================================
do
    -- голое число -> rbxassetid://, остальное (rbxassetid://, rbxthumb://, http) как есть
    local function resolveImage(raw)
        if not raw or raw == "" then return "" end
        raw = tostring(raw):gsub("%s+", "")
        if raw:match("^%d+$") then
            return "rbxassetid://" .. raw
        end
        return raw
    end

    -- фабрика дыры. cfg = { Size, Color, ImageId, Transparency, GuiSize, BeamColor, BeamWidth } — всё опционально
    local function CustomBlackHole(cfg)
        cfg = cfg or {}
        local self = {}
        self.ImageId = cfg.ImageId or ""

        local part = Instance.new("Part")
        part.Name = "TransparentBlackHole"
        part.Size = cfg.Size or Vector3.new(18, 18, 18)
        part.Shape = Enum.PartType.Ball
        part.Anchored = true
        part.CanCollide = false
        part.Material = Enum.Material.Neon
        part.Color = cfg.Color or Color3.fromRGB(15, 15, 15)
        part.Parent = workspace
        self.Part = part

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "BlackHoleBillboard"
        billboard.Adornee = part
        billboard.Size = UDim2.new(0, cfg.GuiSize or 220, 0, cfg.GuiSize or 220)
        billboard.AlwaysOnTop = false
        billboard.LightInfluence = 0
        billboard.Parent = part

        local img = Instance.new("ImageLabel")
        img.Name = "BlackHoleImage"
        img.BackgroundTransparency = 1
        img.Size = UDim2.new(1, 0, 1, 0)
        img.ScaleType = Enum.ScaleType.Fit
        img.Parent = billboard
        self.Image = img

        local ballTransparency = cfg.Transparency or 0.65
        local att0 = Instance.new("Attachment", part)
        local beam = nil
        local extAtt = nil

        -- меняет картинку на лету
        function self:SetImage(idOrUrl)
            self.ImageId = idOrUrl or ""
            local resolved = resolveImage(self.ImageId)
            img.Image = resolved
            img.Visible = (resolved ~= "")
            -- есть картинка -> прячем Neon-шар, дыру рисует только фото
            part.Transparency = (resolved ~= "") and 1 or ballTransparency
        end

        -- ставит дыру в точку (CFrame или Vector3)
        function self:MoveTo(cf)
            if typeof(cf) == "Vector3" then
                part.CFrame = CFrame.new(cf)
            elseif typeof(cf) == "CFrame" then
                part.CFrame = cf
            end
        end

        -- луч от дыры к цели
        function self:AttachBeam(toPart)
            if not toPart then return end
            if beam then beam:Destroy() beam = nil end
            if extAtt then extAtt:Destroy() extAtt = nil end
            extAtt = Instance.new("Attachment", toPart)
            beam = Instance.new("Beam")
            beam.Attachment0 = att0
            beam.Attachment1 = extAtt
            beam.Color = ColorSequence.new(cfg.BeamColor or Color3.fromRGB(255, 255, 255))
            beam.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.2),
                NumberSequenceKeypoint.new(1, 0.75)
            })
            beam.Width0 = cfg.BeamWidth or 3.5
            beam.Width1 = cfg.BeamWidth or 3.5
            beam.FaceCamera = true
            beam.Parent = workspace
        end

        function self:Destroy()
            if beam then beam:Destroy() beam = nil end
            if extAtt then extAtt:Destroy() extAtt = nil end
            if part then part:Destroy() part = nil end
            self.Image = nil
        end

        self:SetImage(self.ImageId)
        return self
    end

    _G.CustomBlackHole = CustomBlackHole
end

-- =========================================================================
-- BLACK HOLE KICK HANDLER — ловит BlackHoleKick в Workspace и правит визуал
-- Текстбокс "Black Hole Image (ID/URL)" ставит свою картинку на дыру.
-- =========================================================================
do
    local bhHandlerOn = false
    local bhConn = nil
    local bhImageId = ""

    -- голое число -> rbxassetid://, остальное как есть
    local function resolveImage(raw)
        if not raw or raw == "" then return "" end
        raw = tostring(raw):gsub("%s+", "")
        if raw:match("^%d+$") then return "rbxassetid://" .. raw end
        return raw
    end

    -- правит визуал одной дыры
    local function applyHole(obj)
        if not obj then return end
        local hole = obj:FindFirstChild("Hole")
        if not hole then return end

        pcall(function()
            hole.Transparency = 1
            hole.Color = Color3.fromRGB(255, 255, 255)   -- было color3, такого свойства нет
        end)

        local gui = hole:FindFirstChild("BillboardGui")
        if not gui then return end

        local resolved = resolveImage(bhImageId)
        for _, name in ipairs({ "Small", "Large" }) do
            local lbl = gui:FindFirstChild(name)
            if lbl then
                pcall(function()
                    lbl.BackgroundTransparency = 1
                    if lbl:IsA("ImageLabel") then
                        if resolved ~= "" then
                            lbl.Image = resolved              -- своя картинка
                            lbl.ImageTransparency = 0
                            lbl.ImageColor3 = Color3.fromRGB(255, 255, 255)
                        else
                            lbl.ImageTransparency = 1         -- прячем родную
                        end
                    else
                        lbl.Transparency = 1
                    end
                end)
            end
        end
    end

    -- проходит по уже висящим дырам
    local function applyAll()
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj.Name == "BlackHoleKick" then applyHole(obj) end
        end
    end

    Elm.Sect.TargetExtra:AddTextbox({
        Name = "Black Hole Image (ID/URL)",
        Default = "",
        TextDisappear = false,
        Callback = function(text)
            bhImageId = text or ""
            if bhHandlerOn then applyAll() end
            notify("Black Hole", (text ~= "" and "Image set") or "Cleared (hidden)", 3)
        end
    })

    Elm.Sect.TargetExtra:AddToggle({
        Name = "Black Hole Visual Handler",
        Default = false,
        Flag = "BlackHoleKickHandler",
        Callback = function(Value)
            bhHandlerOn = Value
            if Value then
                if bhConn then bhConn:Disconnect() end
                bhConn = workspace.ChildAdded:Connect(function(obj)
                    if not bhHandlerOn then return end
                    if obj.Name == "BlackHoleKick" then   -- было obj.name, регистр важен
                        task.wait(0.05)
                        applyHole(obj)
                    end
                end)
                applyAll()
                notify("Black Hole", "Handler enabled", 2)
            else
                if bhConn then bhConn:Disconnect(); bhConn = nil end
                notify("Black Hole", "Handler disabled", 2)
            end
        end
    })
end

-- =========================================================================
-- PALLET RAGDOLL & TRACER — паллета бьет выбранную цель по голове
-- =========================================================================
do
    local palletRagdollActive = false
    local palletRagdollTask = nil
    local activePallet = nil
    local runId = 0

    local function destroyPallet(pallet)
        pallet = pallet or activePallet
        if not pallet then return end

        local menuToys = RS:FindFirstChild("MenuToys")
        local destroyRemote = menuToys and menuToys:FindFirstChild("DestroyToy")
        if destroyRemote then
            pcall(function() destroyRemote:FireServer(pallet) end)
        end
        if pallet.Parent then
            pcall(function() pallet:Destroy() end)
        end
        if activePallet == pallet then activePallet = nil end
    end

    local function cleanupOwnedPallets()
        destroyPallet(activePallet)
        local folder = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
        if not folder then return end
        for _, toy in ipairs(folder:GetChildren()) do
            if toy.Name == "PalletLightBrown" or toy.Name == "RagdollPallet" then
                destroyPallet(toy)
            end
        end
    end

    local function PalletRagdollFunction(targetName, thisRun)
        local target = PS:FindFirstChild(targetName)
        if not target or not target.Character then return end

        local menuToys = RS:FindFirstChild("MenuToys")
        local spawnRemote = menuToys and menuToys:FindFirstChild("SpawnToyRemoteFunction")
        local grabEvents = RS:FindFirstChild("GrabEvents")
        local setOwner = grabEvents and grabEvents:FindFirstChild("SetNetworkOwner")
        local createLine = grabEvents and grabEvents:FindFirstChild("CreateGrabLine")
        local destroyLine = grabEvents and grabEvents:FindFirstChild("DestroyGrabLine")
        if not (spawnRemote and setOwner and createLine and destroyLine) then
            notify("Pallet Ragdoll", "Required remotes are missing", 3)
            return
        end

        local skyPos = CFrame.new(0, 800000, 0)
        cleanupOwnedPallets()

        pcall(function()
            spawnRemote:InvokeServer("PalletLightBrown", skyPos, Vector3.zero)
        end)

        local pallet = nil
        local waitStarted = tick()
        repeat
            local folder = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
            pallet = folder and folder:FindFirstChild("PalletLightBrown")
            R.Heartbeat:Wait()
        until pallet
            or not palletRagdollActive
            or thisRun ~= runId
            or tick() - waitStarted > 5

        if not pallet then
            if palletRagdollActive and thisRun == runId then
                notify("Pallet Ragdoll", "Pallet spawn timed out", 3)
            end
            return
        end

        activePallet = pallet
        pallet.Name = "RagdollPallet"

        local mainPart = pallet:FindFirstChild("SoundPart") or pallet:WaitForChild("SoundPart", 3)
        if not mainPart then
            destroyPallet(pallet)
            return
        end

        mainPart.CanCollide = false
        mainPart.Anchored = false

        for _, part in ipairs(pallet:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanTouch = false
                part.CanQuery = false
            end
        end

        local function claim(part)
            pcall(function() setOwner:FireServer(part, part.CFrame) end)
            pcall(function() createLine:FireServer(part, Vector3.zero, part.Position, false) end)
            pcall(function() destroyLine:FireServer(part) end)
        end

        claim(mainPart)

        while palletRagdollActive and thisRun == runId do
            for _ = 1, 20 do
                if not palletRagdollActive or thisRun ~= runId then break end
                R.Heartbeat:Wait()
            end
            if not palletRagdollActive or thisRun ~= runId then break end
            if not target.Parent or not target.Character then break end
            if not pallet.Parent or not mainPart.Parent then break end

            local head = target.Character:FindFirstChild("Head")
            local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
            if not head or not targetHum or targetHum.Health <= 0 then
                R.Heartbeat:Wait()
                continue
            end

            local hitCF = head.CFrame * CFrame.new(0, 0.2, 0)
            pcall(function()
                mainPart.CFrame = hitCF
                mainPart.AssemblyLinearVelocity = Vector3.zero
                mainPart.AssemblyAngularVelocity = Vector3.new(1000, 1000, 1000)
            end)

            claim(mainPart)
            mainPart.CanCollide = true
            for _ = 1, 3 do R.Heartbeat:Wait() end

            if mainPart and mainPart.Parent then
                mainPart.CanCollide = false
                mainPart.CFrame = skyPos
                mainPart.AssemblyAngularVelocity = Vector3.zero
            end
        end

        destroyPallet(pallet)
    end

    Elm.Sect.TargetExtra:AddToggle({
        Name = "Pallet Ragdoll",
        Default = false,
        Flag = "OwnershipRagdollToggle",
        Callback = function(value)
            runId = runId + 1
            palletRagdollActive = value

            if palletRagdollTask then
                pcall(task.cancel, palletRagdollTask)
                palletRagdollTask = nil
            end

            if value then
                if not selectedKickPlayer or not selectedKickPlayer.Parent then
                    palletRagdollActive = false
                    notify("Pallet Ragdoll", "Select target first", 3)
                    return
                end

                local thisRun = runId
                local targetName = selectedKickPlayer.Name
                palletRagdollTask = task.spawn(function()
                    PalletRagdollFunction(targetName, thisRun)
                    if thisRun == runId then palletRagdollTask = nil end
                end)
            else
                task.spawn(cleanupOwnedPallets)
            end
        end
    })
end

-- =========================================================================
-- PALLET RAGDOLL PULSE — новая короткая физическая атака доской
-- Доска касается выбранной цели только на два physics-кадра, затем уходит в небо.
-- =========================================================================
do
    local pulseActive = false
    local pulseTask = nil
    local pulsePallet = nil
    local pulseRunId = 0
    local pulseDelay = 0.35
    local pulseFrames = 2

    local function removePulsePallet()
        local pallet = pulsePallet
        pulsePallet = nil
        if not pallet then return end

        local menuToys = RS:FindFirstChild("MenuToys")
        local destroyRemote = menuToys and menuToys:FindFirstChild("DestroyToy")
        if destroyRemote then
            pcall(function() destroyRemote:FireServer(pallet) end)
        end
        if pallet.Parent then
            pcall(function() pallet:Destroy() end)
        end
    end

    local function findSpawnedPallet(timeout, currentRun)
        local started = tick()
        repeat
            if not pulseActive or currentRun ~= pulseRunId then return nil end
            local folder = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
            local pallet = folder and folder:FindFirstChild("PalletLightBrown")
            if pallet then return pallet end
            R.Heartbeat:Wait()
        until tick() - started >= timeout
        return nil
    end

    local function pulsePalletRagdoll(targetName, currentRun)
        local target = PS:FindFirstChild(targetName)
        if not target then return end

        local menuToys = RS:FindFirstChild("MenuToys")
        local spawnRemote = menuToys and menuToys:FindFirstChild("SpawnToyRemoteFunction")
        local grabEvents = RS:FindFirstChild("GrabEvents")
        local setOwner = grabEvents and grabEvents:FindFirstChild("SetNetworkOwner")
        local createLine = grabEvents and grabEvents:FindFirstChild("CreateGrabLine")
        local destroyLine = grabEvents and grabEvents:FindFirstChild("DestroyGrabLine")
        if not (spawnRemote and setOwner and createLine and destroyLine) then
            notify("Pallet Pulse", "Required remotes are missing", 3)
            return
        end

        local skyCF = CFrame.new(0, 800000, 0)
        removePulsePallet()

        pcall(function()
            spawnRemote:InvokeServer("PalletLightBrown", skyCF, Vector3.zero)
        end)

        local pallet = findSpawnedPallet(5, currentRun)
        if not pallet then
            if pulseActive and currentRun == pulseRunId then
                notify("Pallet Pulse", "Pallet spawn timed out", 3)
            end
            return
        end

        pulsePallet = pallet
        pallet.Name = "PulseRagdollPallet"
        local mainPart = pallet:FindFirstChild("SoundPart") or pallet:WaitForChild("SoundPart", 3)
        if not mainPart then
            removePulsePallet()
            return
        end

        mainPart.Anchored = false
        mainPart.CanCollide = false
        mainPart.CanTouch = true
        mainPart.CanQuery = false

        for _, part in ipairs(pallet:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanQuery = false
                part.Massless = false
            end
        end

        local function claim(cf)
            pcall(function() setOwner:FireServer(mainPart, cf or mainPart.CFrame) end)
            pcall(function()
                createLine:FireServer(mainPart, Vector3.zero, mainPart.Position, false)
            end)
            pcall(function() destroyLine:FireServer(mainPart) end)
        end

        claim(skyCF)

        while pulseActive and currentRun == pulseRunId do
            if not target.Parent then break end
            local targetCharacter = target.Character
            local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
            local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")

            if targetRoot and targetHumanoid and targetHumanoid.Health > 0
                and pallet.Parent and mainPart.Parent then

                -- Ставим доску прямо в центр тела и раскручиваем. Два Heartbeat дают серверу
                -- зарегистрировать физический контакт, но не оставляют доску на цели постоянно.
                local contactCF = targetRoot.CFrame * CFrame.Angles(
                    math.rad(90), math.rad(45), math.rad(90)
                )

                pcall(function()
                    mainPart.CanCollide = true
                    mainPart.CanTouch = true
                    mainPart.CFrame = contactCF
                    mainPart.AssemblyLinearVelocity = Vector3.zero
                    mainPart.AssemblyAngularVelocity = Vector3.new(1800, 1800, 1800)
                end)
                claim(contactCF)

                for _ = 1, pulseFrames do
                    if not pulseActive or currentRun ~= pulseRunId then break end
                    if not targetRoot.Parent or not mainPart.Parent then break end
                    pcall(function()
                        mainPart.CFrame = targetRoot.CFrame
                        mainPart.AssemblyAngularVelocity = Vector3.new(1800, 1800, 1800)
                    end)
                    R.Heartbeat:Wait()
                end

                if mainPart and mainPart.Parent then
                    pcall(function()
                        mainPart.CanCollide = false
                        mainPart.CFrame = skyCF
                        mainPart.AssemblyLinearVelocity = Vector3.zero
                        mainPart.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
            else
                R.Heartbeat:Wait()
            end

            local waited = 0
            while pulseActive and currentRun == pulseRunId and waited < pulseDelay do
                local dt = R.Heartbeat:Wait()
                waited = waited + dt
            end
        end

        removePulsePallet()
    end

    Elm.Sect.TargetExtra:AddToggle({
        Name = "Pallet Ragdoll Pulse",
        Default = false,
        Flag = "PalletRagdollPulse",
        Callback = function(value)
            pulseRunId = pulseRunId + 1
            pulseActive = value

            if pulseTask then
                pcall(task.cancel, pulseTask)
                pulseTask = nil
            end

            if not value then
                task.spawn(removePulsePallet)
                return
            end

            if not selectedKickPlayer or not selectedKickPlayer.Parent then
                pulseActive = false
                notify("Pallet Pulse", "Select target first", 3)
                return
            end

            local currentRun = pulseRunId
            local targetName = selectedKickPlayer.Name
            pulseTask = task.spawn(function()
                pulsePalletRagdoll(targetName, currentRun)
                if currentRun == pulseRunId then pulseTask = nil end
            end)
        end
    })

    Elm.Sect.TargetExtra:AddSlider({
        Name = "Pallet Pulse Delay",
        Default = 0.35,
        Min = 0.05,
        Max = 2,
        Increment = 0.05,
        ValueName = "sec",
        Flag = "PalletPulseDelay",
        Callback = function(value) pulseDelay = value end
    })

    Elm.Sect.TargetExtra:AddSlider({
        Name = "Pallet Contact Frames",
        Default = 2,
        Min = 1,
        Max = 6,
        Increment = 1,
        ValueName = "frames",
        Flag = "PalletPulseFrames",
        Callback = function(value) pulseFrames = value end
    })
end

-- =========================================================================
-- TRACER TO TARGET — луч от локального игрока к выбранной цели
-- =========================================================================
do
    local traceEnabled = false
    local traceConnection = nil
    local traceBeam = nil
    local tracePart0 = nil
    local tracePart1 = nil
    local traceTargetName = nil

    local traceR, traceG, traceB = 255, 0, 0
    local traceColor = Color3.fromRGB(traceR, traceG, traceB)
    local traceWidth = 0.6

    local function updateTraceColor()
        traceColor = Color3.fromRGB(traceR, traceG, traceB)
        if traceBeam then
            traceBeam.Color = ColorSequence.new(traceColor)
        end
    end

    local function stopTrace()
        traceEnabled = false
        traceTargetName = nil

        if traceConnection then
            traceConnection:Disconnect()
            traceConnection = nil
        end
        if traceBeam then
            traceBeam:Destroy()
            traceBeam = nil
        end
        if tracePart0 then
            tracePart0:Destroy()
            tracePart0 = nil
        end
        if tracePart1 then
            tracePart1:Destroy()
            tracePart1 = nil
        end
    end

    local function makeTraceAnchor(name)
        local part = Instance.new("Part")
        part.Name = name
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CastShadow = false
        part.Transparency = 1
        part.Size = Vector3.new(0.1, 0.1, 0.1)
        part.Parent = Workspace
        return part
    end

    local function startTrace(targetName)
        stopTrace()

        local target = PS:FindFirstChild(targetName)
        if not target then
            notify("Tracer", "Target is no longer in the server", 3)
            return false
        end

        traceEnabled = true
        traceTargetName = targetName
        tracePart0 = makeTraceAnchor("TargetTraceOrigin")
        tracePart1 = makeTraceAnchor("TargetTraceDestination")

        local attachment0 = Instance.new("Attachment")
        attachment0.Name = "TraceAttachment0"
        attachment0.Parent = tracePart0

        local attachment1 = Instance.new("Attachment")
        attachment1.Name = "TraceAttachment1"
        attachment1.Parent = tracePart1

        traceBeam = Instance.new("Beam")
        traceBeam.Name = "TargetTraceBeam"
        traceBeam.Attachment0 = attachment0
        traceBeam.Attachment1 = attachment1
        traceBeam.Color = ColorSequence.new(traceColor)
        traceBeam.Width0 = traceWidth
        traceBeam.Width1 = traceWidth
        traceBeam.LightEmission = 0
        traceBeam.LightInfluence = 1
        traceBeam.FaceCamera = true
        traceBeam.Parent = tracePart0

        traceConnection = R.RenderStepped:Connect(function()
            if not traceEnabled then
                stopTrace()
                return
            end

            local currentTarget = PS:FindFirstChild(traceTargetName or "")
            if not currentTarget then
                stopTrace()
                notify("Tracer", "Target left the server", 2)
                return
            end

            local myCharacter = Player.Character
            local targetCharacter = currentTarget.Character
            local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
            local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")

            if myRoot and targetRoot and tracePart0 and tracePart1 then
                tracePart0.CFrame = myRoot.CFrame
                tracePart1.CFrame = targetRoot.CFrame
                if traceBeam then
                    traceBeam.Color = ColorSequence.new(traceColor)
                    traceBeam.Width0 = traceWidth
                    traceBeam.Width1 = traceWidth
                end
            end
        end)

        return true
    end

    Elm.Sect.VisualsMain:AddToggle({
        Name = "Trace to Target",
        Default = false,
        Flag = "TraceToggle",
        Callback = function(value)
            if value then
                if not selectedKickPlayer or not selectedKickPlayer.Parent then
                    notify("Tracer", "Select target first", 3)
                    stopTrace()
                    return
                end
                startTrace(selectedKickPlayer.Name)
            else
                stopTrace()
            end
        end
    })

    -- BetterOrion в этой сборке не имеет стабильного ColorPicker, поэтому RGB управляется слайдерами.
    Elm.Sect.VisualsMain:AddSlider({
        Name = "Trace Red",
        Default = 255,
        Min = 0,
        Max = 255,
        Increment = 1,
        Flag = "TraceColorR",
        Callback = function(value)
            traceR = value
            updateTraceColor()
        end
    })

    Elm.Sect.VisualsMain:AddSlider({
        Name = "Trace Green",
        Default = 0,
        Min = 0,
        Max = 255,
        Increment = 1,
        Flag = "TraceColorG",
        Callback = function(value)
            traceG = value
            updateTraceColor()
        end
    })

    Elm.Sect.VisualsMain:AddSlider({
        Name = "Trace Blue",
        Default = 0,
        Min = 0,
        Max = 255,
        Increment = 1,
        Flag = "TraceColorB",
        Callback = function(value)
            traceB = value
            updateTraceColor()
        end
    })

    Elm.Sect.VisualsMain:AddSlider({
        Name = "Trace Width",
        Default = 0.6,
        Min = 0.1,
        Max = 5,
        Increment = 0.1,
        ValueName = "studs",
        Flag = "TraceWidth",
        Callback = function(value)
            traceWidth = value
            if traceBeam then
                traceBeam.Width0 = value
                traceBeam.Width1 = value
            end
        end
    })

    -- Если выбранная цель сменилась, активный tracer сразу переезжает на новую цель.
    PS.PlayerRemoving:Connect(function(leavingPlayer)
        if traceEnabled and leavingPlayer.Name == traceTargetName then
            stopTrace()
        end
    end)
end

-- =========================================================================
-- Normal but better — усиленный Ownership Kick, SetNetworkOwner spam-count 12
-- =========================================================================
do
    local ownershipKickActive = false
    local ownershipKickTask = nil
    local OWN_FIRE_COUNT = 12

    local function OwnershipKickFunction(targetName)
        local target = PS:FindFirstChild(targetName)
        if not target then return end

        local GE = RS:WaitForChild("GrabEvents")
        local RunService = R

        local myChar = Player.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local savedPos = myRoot.CFrame
        local dragging = false
        local grabStartTime = 0
        local checkStartTime = 0

        local bodyPos = nil
        local bodyGyro = nil

        local function cleanupBodies()
            pcall(function()
                if bodyPos then bodyPos:Destroy() bodyPos = nil end
                if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
            end)
        end

        local function createBodies(targetRoot, pos)
            cleanupBodies()
            for _, v in pairs(targetRoot:GetChildren()) do
                if v:IsA("BodyPosition") or v:IsA("BodyGyro") then
                    v:Destroy()
                end
            end
            bodyPos = Instance.new("BodyPosition")
            bodyPos.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bodyPos.D = 100
            bodyPos.Position = pos
            bodyPos.Parent = targetRoot

            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bodyGyro.CFrame = CFrame.new(pos)
            bodyGyro.Parent = targetRoot
        end

        local function claimOwner(part, cf)
            for _ = 1, OWN_FIRE_COUNT do
                pcall(function()
                    GE.SetNetworkOwner:FireServer(part, cf)
                end)
            end
            pcall(function()
                GE.DestroyGrabLine:FireServer(part)
            end)
        end

        while ownershipKickActive do
            local currentTarget = PS:FindFirstChild(target.Name)
            if not currentTarget or not currentTarget.Parent then
                cleanupBodies()
                break
            end

            myChar = Player.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local tChar = currentTarget.Character
            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar and tChar:FindFirstChild("Humanoid")

            if tRoot and tHum and tHum.Health > 0 and myRoot then
                if not dragging then
                    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                    cleanupBodies()
                    checkStartTime = 0

                    pcall(function()
                        tHum.PlatformStand = true
                        tHum.Sit = true
                    end)
                    claimOwner(tRoot, tRoot.CFrame)

                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero

                    if grabStartTime == 0 then grabStartTime = tick() end
                    if tick() - grabStartTime > 0.35 then
                        dragging = true
                        grabStartTime = 0
                        checkStartTime = tick()
                        local lockPos = savedPos * CFrame.new(0, 17, 0)
                        createBodies(tRoot, lockPos.Position)
                    end
                else
                    myRoot.CFrame = savedPos
                    local lockPos = savedPos * CFrame.new(0, 17, 0)

                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero

                    if bodyPos and bodyPos.Parent then
                        bodyPos.Position = lockPos.Position
                        if bodyGyro then bodyGyro.CFrame = lockPos end
                    else
                        createBodies(tRoot, lockPos.Position)
                    end

                    tHum.PlatformStand = true
                    claimOwner(tRoot, lockPos)

                    if checkStartTime > 0 and tick() - checkStartTime > 0.30 then
                        local currentDist = (tRoot.Position - lockPos.Position).Magnitude
                        if currentDist > 10 then
                            dragging = false
                            grabStartTime = 0
                            checkStartTime = 0
                            cleanupBodies()
                            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3)
                        else
                            checkStartTime = tick()
                        end
                    end
                end
            else
                dragging = false
                grabStartTime = 0
                checkStartTime = 0
                cleanupBodies()
            end
            RunService.Heartbeat:Wait()
        end

        cleanupBodies()
        if myRoot then myRoot.CFrame = savedPos end
    end

    local function setNormalBetter(value)
        ownershipKickActive = value
        if ownershipKickTask then
            pcall(task.cancel, ownershipKickTask)
            ownershipKickTask = nil
        end

        if value then
            if not selectedKickPlayer or not selectedKickPlayer.Parent then
                ownershipKickActive = false
                notify("Normal but better", "Select target first", 3)
                return false
            end
            local targetName = selectedKickPlayer.Name
            ownershipKickTask = task.spawn(function()
                OwnershipKickFunction(targetName)
                ownershipKickTask = nil
                ownershipKickActive = false
            end)
        end
        return ownershipKickActive
    end

    _G.MellstroyKickModes = _G.MellstroyKickModes or {}
    _G.MellstroyKickModes.setNormal = setNormalBetter
    _G.MellstroyKickModes.getNormal = function() return ownershipKickActive end

    Elm.Sect.TargetExtra:AddToggle({
        Name = "Normal but better",
        Default = false,
        Flag = "NormalButBetterKick",
        Callback = setNormalBetter
    })
end

