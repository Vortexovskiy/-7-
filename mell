-- === Normal Kick (в Target / Kill section v21) ===

do
    local NormalKickEnabled = false

    v21:AddToggle({
        Text = "Normal Kick",
        Default = false,
        Flag = "Targ_NormalKick",
        Callback = function(isGrabbing)
            NormalKickEnabled = isGrabbing
            if not isGrabbing then
                local _, hrp, hum = GetHRH(char)
                if hrp then
                    if hrp:FindFirstChild("BodyPosition") then hrp.BodyPosition:Destroy() end
                    if hrp:FindFirstChild("BodyGyro") then hrp.BodyGyro:Destroy() end
                end
                return
            end

            task.spawn(function()
                local bodyPosition, bodyGyro
                local clone = nil

                local function DestroyBodies()
                    if bodyPosition then bodyPosition:Destroy() bodyPosition = nil end
                    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
                end

                local function GetTarget()
                    local target = AllTargets[1] or next(AllTargets)
                    if target and target.Parent then return target end
                    return nil
                end

                local function InPlot(player)
                    local pi = workspace:FindFirstChild("PlotItems")
                    pi = pi and pi:FindFirstChild("PlayersInPlots")
                    if not pi or not player then return false end
                    return pi:FindFirstChild(player.Name) ~= nil
                end

                local function MakeVisualDummy()
                    local c = LocalPlayer.Character
                    if not c or clone then return end
                    c.Archivable = true
                    clone = c:Clone()
                    c.Archivable = false
                    for _, d in ipairs(clone:GetDescendants()) do
                        if d:IsA("Script") or d:IsA("LocalScript") then d:Destroy() end
                    end
                    clone.Name = "AntiLoseKickDummy"
                    clone.Parent = workspace
                    if clone:FindFirstChild("Humanoid") then
                        workspace.CurrentCamera.CameraSubject = clone.Humanoid
                    end
                end

                local function DestroyVisualDummy()
                    if not clone then return end
                    local _, hrp, hum = GetHRH(char)
                    if hrp and clone:FindFirstChild("HumanoidRootPart") then
                        hrp.CFrame = clone.HumanoidRootPart.CFrame
                        if hum then workspace.CurrentCamera.CameraSubject = hum end
                    end
                    clone:Destroy()
                    clone = nil
                    local c = LocalPlayer.Character
                    if c then
                        for _, d in ipairs(c:GetDescendants()) do
                            if d:IsA("BasePart") then d.LocalTransparencyModifier = 0 end
                        end
                    end
                end

                local kicked = false
                local kickStart = 0

                while NormalKickEnabled and not Library.Unloaded do
                    RunService.RenderStepped:Wait()
                    local target = GetTarget()
                    if not target or not target.Character then continue end

                    local _, hrp, hum = GetHRH(char)
                    local _, thp, thum = GetHRH(target.Character)
                    if not hrp or not hum or hum.Health <= 0 or not thp or not thum or thum.Health <= 0 then continue end

                    if InPlot(target) then
                        DestroyVisualDummy()
                        DestroyBodies()
                        kicked = false
                        continue
                    end

                    if kicked and (hrp.Position - thp.Position).Magnitude > 15 then
                        DestroyBodies()
                        kicked = false
                        kickStart = 0
                    end

                    thp.AssemblyLinearVelocity = Vector3.zero

                    if not kicked then
                        MakeVisualDummy()
                        local c = LocalPlayer.Character
                        if c then
                            for _, d in ipairs(c:GetDescendants()) do
                                if d:IsA("BasePart") then d.LocalTransparencyModifier = 1 end
                            end
                        end
                        if kickStart == 0 then kickStart = tick() end
                        local pos = thp.Position
                        local back = pos - thp.CFrame.LookVector * 4
                        hrp.CFrame = CFrame.new(back.X, pos.Y, back.Z)
                        pcall(function()
                            thum.PlatformStand = true
                            thum.Sit = true
                            GrabEvents.SetNetworkOwner:FireServer(thp, thp.CFrame)
                            GrabEvents.CreateGrabLine:FireServer(thp, Vector3.zero, thp.Position, false)
                        end)
                        if tick() - kickStart > 0.35 then
                            DestroyVisualDummy()
                            kicked = true
                            kickStart = 0
                            if thp then
                                thp.CFrame = hrp.CFrame * CFrame.new(0, 0, -3)
                            end
                        end
                    else
                        DestroyVisualDummy()
                        local pos = hrp.Position + Vector3.new(0, 12, -4)
                        if not bodyPosition or bodyPosition.Parent ~= thp then
                            DestroyBodies()
                            bodyPosition = Instance.new("BodyPosition", thp)
                            bodyPosition.P = 1000000
                            bodyPosition.D = 500
                            bodyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bodyGyro = Instance.new("BodyGyro", thp)
                            bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                        end
                        bodyPosition.Position = pos
                        bodyGyro.CFrame = hrp.CFrame
                        pcall(function()
                            thum.PlatformStand = true
                            GrabEvents.SetNetworkOwner:FireServer(thp, thp.CFrame)
                            GrabEvents.DestroyGrabLine:FireServer(thp)
                            GrabEvents.CreateGrabLine:FireServer(thp, Vector3.zero, thp.Position, false)
                        end)
                    end
                end

                DestroyVisualDummy()
                DestroyBodies()
            end)
        end,
    })
end

