do
    local on, ragSit, cons = false, false, {}
    local function apply(char)
        if not char or not on then return end
        local h = char:WaitForChild("Humanoid", 5)
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not (h and hrp) then return end
        if cons.seat then cons.seat:Disconnect() end
        cons.seat = h:GetPropertyChangedSignal("SeatPart"):Connect(function()
            local seat = h.SeatPart
            if seat and seat.Parent and seat.Parent.Name == "CreatureBlobman" and not ragSit then
                ragSit = true
                while not h.Sit do task.wait() end
                XK.ragdoll(hrp, 3)
                local rv = h:FindFirstChild("Ragdolled")
                while rv and not rv.Value and not h.Sit do task.wait() end
                task.wait(0.4)
                h.Sit = false
                pcall(function() seat:Sit(h) end)
