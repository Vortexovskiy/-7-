    pulse.Radius = easeOut(pT) * 420
    pulse.Thickness = 3 * (1 - pT) + 0.5
    pulse.Transparency = math.clamp(pT * 0.95 + fadeOut, 0, 1)

    if t >= DURATION then
        conn:Disconnect()
        for _, obj in next, {bg, pulse, mainText, subText, linkText} do
            pcall(function() obj:Remove() end)
        end
    end
end)
