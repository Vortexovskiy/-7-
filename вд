local function wrapGroupbox(sec, flags)
    local g = {}

    function g:AddButton(cfg)
        cfg = cfg or {}
        sec:AddButton({
            Name = cfg.Text or cfg.Name or "Button",
            Callback = cfg.Func or cfg.Callback or function() end,
        })
        return {}
    end

    function g:AddLabel(text)
        local label = sec:AddLabel(text or "")
        return {
            dz = label,
            SetText = function(self, t) label.Text = t end,
            Text = function(self, t) label.Text = t end,
        }
    end

    function g:AddToggleButton(name, callback, default)
        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, 0, 0, 28)
        Btn.BackgroundColor3 = ELEMENT_BG
        Btn.BorderSizePixel = 0
        Btn.Font = Enum.Font.GothamMedium
        Btn.Text = name
        Btn.TextColor3 = TEXT_COLOR
        Btn.TextSize = 12
        Btn.AutoButtonColor = false
        Btn.Parent = sec.Holder
        corner(Btn, 8)
        stroke(Btn, STROKE_COLOR, 0.5, 1)
        local state = default == true
        local hovering = false

        local function refresh()
            local bg = state and TOGGLE_ON_BG or ELEMENT_BG
            if hovering and not state then bg = TOGGLE_HOVER end
            tween(Btn, 0.15, { BackgroundColor3 = bg })
        end
        refresh()

        Btn.MouseEnter:Connect(function()
            hovering = true
            if not state then tween(Btn, 0.12, { BackgroundColor3 = TOGGLE_HOVER }) end
        end)
        Btn.MouseLeave:Connect(function()
            hovering = false
            if not state then tween(Btn, 0.12, { BackgroundColor3 = ELEMENT_BG }) end
        end)

        local function setState(newState)
            if state == newState then return end
            state = newState
            refresh()
            callback(state)
        end

        Btn.MouseButton1Click:Connect(function()
            setState(not state)
        end)

        return {
            Btn = Btn,
            IsActive = function() return state end,
            SetState = setState,
            ForceState = function(v)
                state = v
                refresh()
            end,
        }
    end

    function g:AddSlider(flag, cfg)
        cfg = cfg or {}
        local sl = sec:AddSlider({
            Name = cfg.Text or flag,
            Min = cfg.Min or 0,
            Max = cfg.Max or 100,
            Default = cfg.Default or 0,
            Step = cfg.Step or 1,
            Suffix = cfg.Suffix or "",
            Callback = cfg.Callback or function() end,
        })
        flags.Options[flag] = sl
        return sl
    end

    function g:AddColorPicker(cfg)
        return sec:AddColorPicker(cfg)
    end

    function g:AddDropdown(flag, cfg)
        cfg = cfg or {}
        local obj = sec:AddDropdown({
            Name = cfg.Text or flag,
            Values = cfg.Values or {},
            Default = cfg.Default or (cfg.Values and cfg.Values[1]) or "",
            Multi = cfg.Multi or false,
            SpecialType = cfg.SpecialType,
            EnablePlayerImages = cfg.EnablePlayerImages,
            FormatListValue = cfg.FormatListValue,
            FormatDisplayValue = cfg.FormatDisplayValue,
            Callback = cfg.Callback or function() end,
        })
        local wrapper = {
            SetValue = function(self, v) obj.Set(v) end,
            GetValue = function(self) return obj.Get() end,
            SetValues = function(self, list) obj.SetValues(list) end,
        }
        flags.Options[flag] = wrapper
        return wrapper
    end

    function g:AddDivider() end

    return g
end

