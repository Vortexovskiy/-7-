        CL.TextXAlignment = Enum.TextXAlignment.Left
        CL.ZIndex = 201
        CL.Parent = Popup

        local Bar = Instance.new("TextButton")
        Bar.Size = UDim2.new(1, -36, 0, 8)
        Bar.Position = UDim2.new(0, 28, 0, ch.YOffset + 12)
        Bar.BackgroundColor3 = ELEMENT_BG
        Bar.BorderSizePixel = 0
        Bar.Text = ""
        Bar.AutoButtonColor = false
        Bar.ZIndex = 201
        Bar.Parent = Popup
        corner(Bar, 4)

        local Fill = Instance.new("Frame")
        Fill.BackgroundColor3 = ACCENT
        Fill.BorderSizePixel = 0
        Fill.Size = UDim2.new(color[ch.Prop], 0, 1, 0)
        Fill.ZIndex = 202
        Fill.Parent = Bar
        corner(Fill, 4)
        fills[ch.Prop] = Fill

        local drag = false
        local function upd(mx)
            local t = math.clamp((mx - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
            local v = math.floor(t * 255 + 0.5) / 255
            local r = ch.Prop == "R" and v or color.R
            local g = ch.Prop == "G" and v or color.G
            local b = ch.Prop == "B" and v or color.B
            setColor(Color3.new(r, g, b))
        end

        Bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                drag = true
                upd(input.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                upd(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                drag = false
            end
        end)
    end

    local isOpen = false
    local function closeFn()
        isOpen = false
        Popup.Visible = false
    end

    Btn.MouseButton1Click:Connect(function()
        if isOpen then
            closePopup(Popup)
            return
        end
        closeAllPopups(Popup)
        local px = Btn.AbsolutePosition.X
        local py = Btn.AbsolutePosition.Y + 26
        local vp = workspace.CurrentCamera.ViewportSize
        if px + 180 > vp.X - 5 then px = vp.X - 185 end
        if py + 112 > vp.Y - 5 then py = Btn.AbsolutePosition.Y - 118 end
        Popup.Position = UDim2.fromOffset(px, py)
        Popup.Visible = true
        isOpen = true
        registerPopup(Popup, closeFn)
    end)

    return {
        Get = function() return color end,
        Set = function(c) setColor(c) end,
    }
end

