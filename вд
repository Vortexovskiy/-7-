function UI:AddDropdown(cfg)
    cfg = cfg or {}
    local values = cfg.Values or {}
    local multi = cfg.Multi or false
    local formatListValue = cfg.FormatListValue or function(v)
        if typeof(v) == "Instance" then return v.DisplayName or v.Name end
        return tostring(v)
    end
    local formatDisplayValue = cfg.FormatDisplayValue or formatListValue
    local cb = cfg.Callback or function() end
    local enablePlayerImages = cfg.EnablePlayerImages and cfg.SpecialType == "Player"

    local current
    if multi then
        current = {}
        if typeof(cfg.Default) == "table" then
            for k, v in pairs(cfg.Default) do current[k] = v end
        elseif cfg.Default then
            current[cfg.Default] = true
        end
    else
        current = cfg.Default or (values[1] or "")
    end

    local Row = createRow(self.Holder, cfg.Name or "Dropdown", 28)

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -80, 0, 22)
    Btn.Position = UDim2.new(1, -2, 0.5, 0)
    Btn.AnchorPoint = Vector2.new(1, 0.5)
    Btn.BackgroundColor3 = ELEMENT_BG
    Btn.BorderSizePixel = 0
    Btn.Text = ""
    Btn.AutoButtonColor = false
    Btn.Parent = Row
    corner(Btn, 6)
    stroke(Btn, STROKE_COLOR, 0.5, 1)

    local BtnText = Instance.new("TextLabel")
    BtnText.BackgroundTransparency = 1
    BtnText.Position = UDim2.new(0, 8, 0, 0)
    BtnText.Size = UDim2.new(1, -24, 1, 0)
    BtnText.Font = Enum.Font.GothamMedium
    BtnText.TextColor3 = TEXT_COLOR
    BtnText.TextSize = 11
    BtnText.TextXAlignment = Enum.TextXAlignment.Left
    BtnText.TextTruncate = Enum.TextTruncate.AtEnd
    BtnText.Parent = Btn

    local Arrow = Instance.new("TextLabel")
    Arrow.BackgroundTransparency = 1
    Arrow.Position = UDim2.new(1, -18, 0, 0)
    Arrow.Size = UDim2.fromOffset(16, 22)
    Arrow.Font = Enum.Font.GothamBold
    Arrow.Text = "v"
    Arrow.TextColor3 = TEXT_DIM
    Arrow.TextSize = 10
    Arrow.Parent = Btn

    local Popup = Instance.new("Frame")
    Popup.Size = UDim2.fromOffset(180, 0)
    Popup.BackgroundColor3 = PANEL_BG
    Popup.BorderSizePixel = 0
    Popup.Visible = false
    Popup.ZIndex = 200
    Popup.ClipsDescendants = true
    Popup.Parent = screenGui
    corner(Popup, 8)
    stroke(Popup, STROKE_COLOR, 0.3, 1)

    local Scroll = Instance.new("ScrollingFrame")
    Scroll.BackgroundTransparency = 1
    Scroll.BorderSizePixel = 0
    Scroll.Position = UDim2.new(0, 4, 0, 4)
    Scroll.Size = UDim2.new(1, -8, 1, -8)
    Scroll.ScrollBarThickness = 2
    Scroll.ScrollBarImageColor3 = ACCENT
    Scroll.ScrollBarImageTransparency = 0.3
    Scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    Scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Scroll.Parent = Popup

    local ListLayout = Instance.new("UIListLayout")
    ListLayout.Padding = UDim.new(0, 2)
    ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ListLayout.Parent = Scroll

    local items = {}

    local function isSelected(v)
        if multi then return current[v] == true end
        return current == v
    end

    local function updateBtnText()
        if multi then
            local list = {}
            for k in pairs(current) do
                table.insert(list, formatDisplayValue(k))
            end
            if #list == 0 then
                BtnText.Text = "---"
            elseif #list <= 2 then
                BtnText.Text = table.concat(list, ", ")
            else
                BtnText.Text = list[1] .. " +" .. (#list - 1)
            end
        else
            BtnText.Text = (current and current ~= "") and tostring(formatDisplayValue(current)) or "---"
        end
    end

    local function rebuild(list)
        for _, it in ipairs(items) do it:Destroy() end
        items = {}
        for _, v in ipairs(list) do
            local Item = Instance.new("TextButton")
            Item.Size = UDim2.new(1, -4, 0, 22)
            Item.BackgroundColor3 = ELEMENT_BG
            Item.BackgroundTransparency = 1
            Item.BorderSizePixel = 0
            Item.Font = Enum.Font.GothamMedium
            Item.Text = tostring(formatListValue(v))
            Item.TextColor3 = TEXT_COLOR
            Item.TextSize = 11
            Item.TextXAlignment = Enum.TextXAlignment.Left
            Item.AutoButtonColor = false
            Item.Parent = Scroll
            corner(Item, 4)
            local IPad = Instance.new("UIPadding")
            IPad.PaddingLeft = UDim.new(0, 8)
            IPad.Parent = Item

            if enablePlayerImages and typeof(v) == "Instance" and v:IsA("Player") then
                local icon = Instance.new("ImageLabel")
                icon.BackgroundTransparency = 1
                icon.Size = UDim2.fromOffset(16, 16)
                icon.Position = UDim2.fromOffset(4, 3)
                icon.Parent = Item
                IPad.PaddingLeft = UDim.new(0, 28)
                task.spawn(function()
                    local ok, url = pcall(function()
                        return Players:GetUserThumbnailAsync(v.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                    end)
                    if ok and url then icon.Image = url end
                end)
            end

            local function refresh()
                local sel = isSelected(v)
                Item.TextColor3 = sel and ACCENT or TEXT_COLOR
                Item.BackgroundTransparency = sel and 0 or 1
            end
            refresh()
            Item.MouseEnter:Connect(function()
                if not isSelected(v) then
                    tween(Item, 0.1, { BackgroundTransparency = 0.5 })
                end
            end)
            Item.MouseLeave:Connect(function()
                if not isSelected(v) then
                    tween(Item, 0.1, { BackgroundTransparency = 1 })
                end
            end)
            Item.MouseButton1Click:Connect(function()
                if multi then
                    if current[v] then
                        current[v] = nil
                    else
                        current[v] = true
                    end
                    refresh()
                    updateBtnText()
                    cb(current)
                else
                    current = v
                    updateBtnText()
                    closeAllPopups()
                    cb(v)
                end
            end)
            table.insert(items, Item)
        end
        updateBtnText()
    end

    rebuild(values)

    local isOpen = false
    local POPUP_WIDTH = 180

    local function animateClose()
        if not isOpen then return end
        isOpen = false
        tween(Popup, 0.18, { Size = UDim2.fromOffset(POPUP_WIDTH, 0), BackgroundTransparency = 0.35 })
        task.delay(0.19, function()
            if not isOpen then Popup.Visible = false end
        end)
    end

    local function animateOpen()
        local totalHeight = math.min(#values * 24 + 8, 240)
        local px = Btn.AbsolutePosition.X
        local py = Btn.AbsolutePosition.Y + 28
        local vp = workspace.CurrentCamera.ViewportSize
        if px + POPUP_WIDTH > vp.X - 5 then px = vp.X - POPUP_WIDTH - 5 end
        if py + totalHeight > vp.Y - 5 then py = Btn.AbsolutePosition.Y - totalHeight - 6 end

        Popup.Position = UDim2.fromOffset(px, py)
        Popup.Size = UDim2.fromOffset(POPUP_WIDTH, 0)
        Popup.BackgroundTransparency = 0.35
        Popup.Visible = true
        isOpen = true

        tween(Popup, 0.22, { Size = UDim2.fromOffset(POPUP_WIDTH, totalHeight), BackgroundTransparency = 0 })
    end

    Btn.MouseButton1Click:Connect(function()
        local willOpen = not isOpen
        closeAllPopups(Popup)
        if willOpen then
            animateOpen()
            registerPopup(Popup, animateClose)
        else
            animateClose()
            unregisterPopup(Popup)
        end
    end)

    updateBtnText()

    return {
        Get = function() return current end,
        Set = function(v)
            current = v or (multi and {} or nil)
            rebuild(values)
            cb(current)
        end,
        SetValues = function(list)
            values = list
            rebuild(list)
        end,
    }
end

