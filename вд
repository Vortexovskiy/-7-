            dragging = true
            dragStart = input.Position
            startPos = Window.Position
            local endConn
            endConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    endConn:Disconnect()
                end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            Window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    self:SetVisible(true)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == WINDOW_KEYBIND then
            self:SetVisible(not self.Visible)
        end
    end)

    return self
end

function UI:SetVisible(v)
    self.Visible = v
    if v then
        self.Window.Visible = true
        self.Window.Size = UDim2.fromOffset(0, 0)
        tween(self.Window, 0.22, { Size = self.Size })
    else
        tween(self.Window, 0.15, { Size = UDim2.fromOffset(0, 0) })
        task.delay(0.16, function()
            if not self.Visible then self.Window.Visible = false end
        end)
    end
end

