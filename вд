    if not state then SmoothCamState.SavedCF = nil return end
    if SmoothCamState.AutoKillerDisable and isKiller() then
        SmoothCamState.Enabled = false
        smoothCamToggle.ForceState(false)
        Notify({ Title = "Smooth Camera", Content = "Blocked: you are Killer", Duration = 3 })
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    SmoothCamState.SavedCF = cam.CFrame
    SmoothCamState.Conn = RunService.RenderStepped:Connect(function()
        if not SmoothCamState.Enabled then return end
        local c = workspace.CurrentCamera
        if not c then return end
        local currentCF = c.CFrame
        local amount = SmoothCamState.Amount or 0.5
        local lerpFactor = math.clamp(1 - amount, 0.05, 1)
        local newPos = SmoothCamState.SavedCF.Position:Lerp(currentCF.Position, lerpFactor)
        SmoothCamState.SavedCF = CFrame.new(newPos)
        local rotOffset = currentCF - currentCF.Position
        c.CFrame = CFrame.new(newPos) * rotOffset
    end)
end)
