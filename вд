-- ============ Character Transparency (Optimized Lookup) ============
local TranspState = { Values = {} }

local PART_GROUPS = {
    ["Head"]      = { "Head" },
    ["Torso"]     = { "Torso", "UpperTorso", "LowerTorso" },
    ["Left Arm"]  = { "Left Arm", "LeftUpperArm", "LeftLowerArm", "LeftHand" },
    ["Right Arm"] = { "Right Arm", "RightUpperArm", "RightLowerArm", "RightHand" },
    ["Left Leg"]  = { "Left Leg", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot" },
    ["Right Leg"] = { "Right Leg", "RightUpperLeg", "RightLowerLeg", "RightFoot" },
}

local PART_NAME_TO_GROUP = {}
for group, names in pairs(PART_GROUPS) do
    for _, n in ipairs(names) do PART_NAME_TO_GROUP[n] = group end
end

local function applyToPart(part)
    if not part or not part:IsA("BasePart") then return end
    local group = PART_NAME_TO_GROUP[part.Name]
    if not group then return end
    local v = TranspState.Values[group]
    if v == nil then v = 0 end
    part.LocalTransparencyModifier = v
end

local function applyGroupToChar(char, groupName)
    if not char then return end
    local v = TranspState.Values[groupName] or 0
    local names = PART_GROUPS[groupName]
    if not names then return end
    -- Оптимизация: точечный поиск вместо GetDescendants
    for _, n in ipairs(names) do
        local part = char:FindFirstChild(n)
        if part and part:IsA("BasePart") then
            part.LocalTransparencyModifier = v
        end
    end
end

local function applyAllToChar(char)
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        applyToPart(d)
    end
end

local function onCharAdded(char)
    applyAllToChar(char)
    char.DescendantAdded:Connect(function(d)
        if d:IsA("BasePart") then
            task.defer(function()
                if d.Parent then applyToPart(d) end
            end)
        end
    end)
end

if LocalPlayer.Character then onCharAdded(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(onCharAdded)

local function setPartTransparency(partName, value)
    TranspState.Values[partName] = value
    applyGroupToChar(LocalPlayer.Character, partName)
end

