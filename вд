-- ============================ POPUP ==================================
local activePopups = {}
local popupClosers = {}

local function registerPopup(p, closer)
    activePopups[p] = true
    if closer then popupClosers[p] = closer end
end

local function unregisterPopup(p)
    activePopups[p] = nil
    popupClosers[p] = nil
end

local function closePopup(p)
    local closer = popupClosers[p]
    unregisterPopup(p)
    if closer then
        pcall(closer)
    else
        p.Visible = false
    end
end

local function closeAllPopups(except)
    for p in pairs(activePopups) do
        if p ~= except then closePopup(p) end
    end
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local mx, my = input.Position.X, input.Position.Y
    for p in pairs(activePopups) do
        local px, py = p.AbsolutePosition.X, p.AbsolutePosition.Y
        local pw, ph = p.AbsoluteSize.X, p.AbsoluteSize.Y
        if not (mx >= px and mx <= px + pw and my >= py and my <= py + ph) then
            closePopup(p)
        end
    end
end)

