-- ============ ESP (белый контур) ============
local ESPState = {
    Enabled = false,
    Color = Color3.fromRGB(255, 255, 255),
    Highlights = {},
}

local function destroyESP(plr)
    local hl = ESPState.Highlights[plr]
    if hl then hl:Destroy() end
    ESPState.Highlights[plr] = nil
end

local function clearAllESP()
    for plr in pairs(ESPState.Highlights) do
        destroyESP(plr)
    end
    table.clear(ESPState.Highlights)
end

local function createESP(plr)
    if plr == LocalPlayer then return end
    if ESPState.Highlights[plr] then return end
    local char = plr.Character
    if not char then return end

    -- Проверка: не вешаем на трупы (снижает нагрузку)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local hl = Instance.new("Highlight")
    hl.Name = "moggESP"
    hl.Adornee = char
    hl.FillTransparency = 1
    hl.OutlineColor = ESPState.Color
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char
    ESPState.Highlights[plr] = hl
end

local function refreshESP(plr)
    destroyESP(plr)
    if ESPState.Enabled then
        createESP(plr)
    end
end

local function startESP()
    -- Создаем Highlight'ы с задержкой, чтобы игра не фризила
    task.spawn(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if not ESPState.Enabled then break end
            createESP(plr)
            task.wait(0.05) -- 50мс между игроками
        end
    end)
end

local function stopESP()
    clearAllESP()
end

