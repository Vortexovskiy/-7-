local function makeLibrary(cfg)
    local flags = { Toggles = {}, Options = {}, Flags = {} }
    local Library = {}
    Library.Toggles = flags.Toggles
    Library.Options = flags.Options
    Library.Flags = flags.Flags

    function Library:CreateWindow(wcfg)
        wcfg = wcfg or {}
