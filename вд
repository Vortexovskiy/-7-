local function scanForTraps()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isTrap(obj) then
            createTrapESP(obj)
        end
    end
end

local function startTrapESP()
    scanForTraps() -- Первичный скан
    -- Подписываемся на появление новых объектов вместо цикла
    if not TrapESPState.ConnAdded then
        TrapESPState.ConnAdded = workspace.DescendantAdded:Connect(function(obj)
            if TrapESPState.Enabled and isTrap(obj) then
                createTrapESP(obj)
            end
        end)
    end
end

local function stopTrapESP()
    TrapESPState.Enabled = false
    if TrapESPState.ConnAdded then
        TrapESPState.ConnAdded:Disconnect()
        TrapESPState.ConnAdded = nil
    end
    clearAllTrapESP()
end

