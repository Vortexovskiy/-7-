-- ============ Killer detection ============
local KILLER_KEYWORDS = { "kill", "murder", "villain", "slaughter", "hunter", "maniac", "psycho", "psyho", "slender", "hidden" }
local KILLER_ATTRS    = { "IsKiller", "isKiller", "Role", "Team", "Killer", "Class", "Type", "Monster" }
local KILLER_TAGS     = { "Killer", "Murderer", "Maniac", "Slaughter", "Monster" }
local HIGH_HP_THRESHOLD = 500

local function strHasKiller(txt)
    if not txt then return false end
    txt = tostring(txt):lower()
    for _, kw in ipairs(KILLER_KEYWORDS) do
        if txt:find(kw, 1, true) then return true end
    end
    return false
end

local function analyzePlayer(plr)
    if plr.Team and strHasKiller(plr.Team.Name) then return true end
    for _, attr in ipairs(KILLER_ATTRS) do
        local v = plr:GetAttribute(attr)
        if v == true then return true end
        if typeof(v) == "string" and strHasKiller(v) then return true end
    end
    local char = plr.Character
    if char then
        for _, attr in ipairs(KILLER_ATTRS) do
            local v = char:GetAttribute(attr)
            if v == true then return true end
            if typeof(v) == "string" and strHasKiller(v) then return true end
        end
        for _, tag in ipairs(KILLER_TAGS) do
            if CollectionService:HasTag(char, tag) then return true end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.MaxHealth >= HIGH_HP_THRESHOLD then return true end
    end
    for _, tag in ipairs(KILLER_TAGS) do
        if CollectionService:HasTag(plr, tag) then return true end
    end
    return false
end

local function isKiller()
    return analyzePlayer(LocalPlayer)
end

local function forceDisableSmoothCam(reason)
    SmoothCamState.Enabled = false
    if SmoothCamState.Conn then
        SmoothCamState.Conn:Disconnect()
        SmoothCamState.Conn = nil
    end
    SmoothCamState.SavedCF = nil
    if SmoothCamState.ToggleObj then
        SmoothCamState.ToggleObj.ForceState(false)
    end
    if reason then
        Notify({ Title = "Smooth Camera", Content = reason, Duration = 3 })
    end
end

task.spawn(function()
    local prev = nil
    while true do
        task.wait(0.5)
        local k = isKiller()
        if k ~= prev then
            prev = k
            if k then print("[mogg] Killer mode detected.") else print("[mogg] Not killer mode.") end
        end
        if k and SmoothCamState.Enabled and SmoothCamState.AutoKillerDisable then
            forceDisableSmoothCam("Auto-disabled (Killer mode)")
        end
    end
end)

