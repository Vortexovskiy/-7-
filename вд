function UI:SelectTab(Tab)
    for _, t in ipairs(self.Tabs) do
        if t == Tab then
            t.ContentFrame.Visible = true
            tween(t.Label, 0.15, { TextColor3 = TEXT_COLOR })
            tween(t.IconLabel, 0.15, { ImageColor3 = ACCENT })
            tween(t.Button, 0.15, { BackgroundTransparency = 0.55 })
            tween(t.Indicator, 0.15, { BackgroundTransparency = 0 })
            self.ContentTitle.Text = t.Name
            self.ContentIcon.Image = t.Icon
        else
            t.ContentFrame.Visible = false
            tween(t.Label, 0.15, { TextColor3 = TEXT_DIM })
            tween(t.IconLabel, 0.15, { ImageColor3 = TEXT_DIM })
            tween(t.Button, 0.15, { BackgroundTransparency = 1 })
            tween(t.Indicator, 0.15, { BackgroundTransparency = 1 })
        end
    end
end

